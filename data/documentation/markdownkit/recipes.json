{"abstract":[{"text":"Solve common tasks with a few lines of MarkdownKit.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/Recipes"},"kind":"article","metadata":{"modules":[{"name":"MarkdownKit"}],"role":"article","roleHeading":"Article","title":"Recipes"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Each recipe is self-contained. They use the shared parsers and generators, so they can be called from any thread, except where noted.","type":"text"}],"type":"paragraph"},{"anchor":"Convert-a-Markdown-file-into-an-HTML-page","level":3,"text":"Convert a Markdown file into an HTML page","type":"heading"},{"inlineContent":[{"text":"Read the file, parse it, and generate the HTML. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":" creates the content of the page; you add the surrounding document:","type":"text"}],"type":"paragraph"},{"code":["let markdown = try String(contentsOf: URL(fileURLWithPath: \"README.md\"), encoding: .utf8)","let body = HtmlGenerator.standard.generate(doc: FullMarkdownParser.standard.parse(markdown))","let page = \"<!DOCTYPE html>\\n<html><head><meta charset=\\\"utf-8\\\"></head><body>\\n\\(body)</body></html>\"","try page.write(toFile: \"README.html\", atomically: true, encoding: .utf8)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If the Markdown does not come from you, use ","type":"text"},{"code":"HtmlGenerator(safeMode: true)","type":"codeVoice"},{"text":", see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/RenderingUntrustedMarkdown","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Build-a-table-of-contents","level":3,"text":"Build a table of contents","type":"heading"},{"inlineContent":[{"text":"Walk the blocks of the document and collect its headings. This function returns a Markdown list with one entry for each heading, indented by its level:","type":"text"}],"type":"paragraph"},{"code":["func tableOfContents(of doc: Block) -> String {","  func headings(in block: Block) -> [(Int, String)] {","    switch block {","      case .document(let blocks), .blockquote(let blocks):","        return blocks.flatMap(headings(in:))","      case .heading(let level, let text):","        return [(level, text.rawDescription)]","      default:","        return []","    }","  }","  return headings(in: doc)","    .map { String(repeating: \"  \", count: $0.0 - 1) + \"- \" + $0.1 }","    .joined(separator: \"\\n\")","}","print(tableOfContents(of: MarkdownParser.standard.parse(\"# One\\n\\n## Two\\n\\n# Three\")))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This prints:","type":"text"}],"type":"paragraph"},{"code":["- One","  - Two","- Three"],"syntax":null,"type":"codeListing"},{"anchor":"Count-the-words-of-a-document","level":3,"text":"Count the words of a document","type":"heading"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block/string","isActive":true,"type":"reference"},{"text":" returns the text of a block without any markup, which you can split into words:","type":"text"}],"type":"paragraph"},{"code":["let doc = MarkdownParser.standard.parse(\"# Title\\n\\nSome **important** text.\")","let words = doc.string.split(whereSeparator: \\.isWhitespace).count"],"syntax":"swift","type":"codeListing"},{"anchor":"Show-Markdown-in-a-text-view","level":3,"text":"Show Markdown in a text view","type":"heading"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":" creates the attributed string for an ","type":"text"},{"code":"NSTextView","type":"codeVoice"},{"text":" or a ","type":"text"},{"code":"UITextView","type":"codeVoice"},{"text":". Generate it on the main thread, or use ","type":"text"},{"code":"generateAsync","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let doc = FullMarkdownParser.standard.parse(markdown)","textView.textStorage?.setAttributedString(AttributedStringGenerator.standard.generate(doc: doc) ?? NSAttributedString())"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"On iOS, the text storage is not optional: ","type":"text"},{"code":"textView.textStorage.setAttributedString(…)","type":"codeVoice"},{"text":". In SwiftUI, use ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownText","isActive":true,"type":"reference"},{"text":", see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/DisplayingMarkdownWithSwiftUI","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Print-Markdown-to-a-terminal","level":3,"text":"Print Markdown to a terminal","type":"heading"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator","isActive":true,"type":"reference"},{"text":" produces text with ANSI escape sequences:","type":"text"}],"type":"paragraph"},{"code":["let doc = FullMarkdownParser.standard.parse(markdown)","print(TerminalGenerator(numColumns: 72).generate(doc: doc).encodedString)"],"syntax":"swift","type":"codeListing"},{"anchor":"Show-a-text-from-a-user-safely","level":3,"text":"Show a text from a user safely","type":"heading"},{"inlineContent":[{"text":"Text from users should not load local files or remote resources. The ","type":"text"},{"code":".untrusted","type":"codeVoice"},{"text":" rendering options omit raw HTML, restrict links and load no images:","type":"text"}],"type":"paragraph"},{"code":["let generator = AttributedStringGenerator(renderingOptions: .untrusted)","let doc = ExtendedMarkdownParser.standard.parse(userText)","let attributedStr = try await generator.generateAsync(doc: doc)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/RenderingUntrustedMarkdown","isActive":true,"type":"reference"},{"text":" for allowing images from one web site.","type":"text"}],"type":"paragraph"},{"anchor":"Parse-in-the-background","level":3,"text":"Parse in the background","type":"heading"},{"inlineContent":[{"text":"Parsing large documents takes time. Do it in a background task and use the result in your views, see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator":{"abstract":[{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into","type":"text"},{"text":" ","type":"text"},{"code":"NSAttributedString","type":"codeVoice"},{"text":" objects that are used in macOS and iOS for displaying rich text.","type":"text"},{"text":" ","type":"text"},{"text":"The implementation is extensible allowing subclasses of ","type":"text"},{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"override how individual Markdown structures are converted into attributed strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AttributedStringGenerator"}],"identifier":"doc://MarkdownKit/documentatio