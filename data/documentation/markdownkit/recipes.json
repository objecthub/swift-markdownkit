rted","type":"topic","url":"/documentation/markdownkit/gettingstarted"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator":{"abstract":[{"code":"HtmlGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into HTML. The","type":"text"},{"text":" ","type":"text"},{"text":"implementation is extensible allowing subclasses of ","type":"text"},{"code":"HtmlGenerator","type":"codeVoice"},{"text":" to override how","type":"text"},{"text":" ","type":"text"},{"text":"individual Markdown structures are converted into HTML.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"HtmlGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HtmlGenerator"}],"role":"symbol","title":"HtmlGenerator","type":"topic","url":"/documentation/markdownkit/htmlgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownText":{"abstract":[{"text":"A SwiftUI view that displays a Markdown document as formatted text. The view converts the","type":"text"},{"text":" ","type":"text"},{"text":"document into an attributed string with an ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":", using different","type":"text"},{"text":" ","type":"text"},{"text":"generators for light and dark mode, and shows the result in a read-only text view whose text","type":"text"},{"text":" ","type":"text"},{"text":"can be selected. The view scrolls vertically.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MarkdownText"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownText","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MarkdownText"}],"role":"symbol","title":"MarkdownText","type":"topic","url":"/documentation/markdownkit/markdowntext"},"doc://MarkdownKit/documentation/MarkdownKit/MigrationGuide":{"abstract":[{"text":"Find out what to change in your code when you update MarkdownKit.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MigrationGuide","kind":"article","role":"article","title":"Migrating to Newer Versions","type":"topic","url":"/documentation/markdownkit/migrationguide"},"doc://MarkdownKit/documentation/MarkdownKit/ProcessingMarkdown":{"abstract":[{"text":"Walk the abstract syntax tree of a parsed document to extract information or to transform it.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ProcessingMarkdown","kind":"article","role":"article","title":"Processing Markdown","type":"topic","url":"/documentation/markdownkit/processingmarkdown"},"doc://MarkdownKit/documentation/MarkdownKit/RenderingUntrustedMarkdown":{"abstract":[{"text":"Restrict what raw HTML, links and images in a document may do when the Markdown does not come from you.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/RenderingUntrustedMarkdown","kind":"article","role":"article","title":"Rendering Untrusted Markdown","type":"topic","url":"/documentation/markdownkit/renderinguntrustedmarkdown"},"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator":{"abstract":[{"code":"TerminalGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into text for","type":"text"},{"text":" ","type":"text"},{"text":"ANSI-compliant terminals, with word wrapping, indentation, and styled text. The result is","type":"text"},{"text":" ","type":"text"},{"text":"marked up with ANSI escape sequences. The implementation is extensible allowing subclasses","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"TerminalGenerator","type":"codeVoice"},{"text":" to override how individual Markdown structures are converted into","type":"text"},{"text":" ","type":"text"},{"text":"styled text.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TerminalGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TerminalGenerator"}],"role":"symbol","title":"TerminalGenerator","type":"topic","url":"/documentation/markdownkit/terminalgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently":{"abstract":[{"text":"Parse and generate on background threads and tasks, and know what to restate in subclasses.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently","kind":"article","role":"article","title":"Using MarkdownKit Concurrently","type":"topic","url":"/documentation/markdownkit/usingmarkdownkitconcurrently"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc://MarkdownKit/documentation/MarkdownKit/ProcessingMarkdown","doc://MarkdownKit/documentation/MarkdownKit/GeneratingOutput"],"title":"Related Documentation"},{"anchor":"Essentials","generated":true,"identifiers":["doc://MarkdownKit/documentation/MarkdownKit/GettingStarted","doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently","doc://MarkdownKit/documentation/MarkdownKit/MigrationGuide"],"title":"Essentials"}],"variants":[{"paths":["/documentation/markdownkit/recipes"],"traits":[{"interfaceLanguage":"swift"}]}]}