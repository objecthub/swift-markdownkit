{"abstract":[{"text":"Creates a renderer which uses the Mermaid JavaScript library at ","type":"text"},{"code":"mermaidJSURL","type":"codeVoice"},{"text":" (an","type":"text"},{"text":" ","type":"text"},{"text":"“IIFE” build such as ","type":"text"},{"code":"mermaid.min.js","type":"codeVoice"},{"text":", which defines the global ","type":"text"},{"code":"mermaid","type":"codeVoice"},{"text":").","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit","doc://MarkdownKit/documentation/MarkdownKit/MermaidRenderer"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/MermaidRenderer/init(mermaidJSURL:cachesScript:idleTime:maxCachedDiagrams:maxCacheBytes:)"},"kind":"symbol","metadata":{"externalID":"s:11MarkdownKit15MermaidRendererC12mermaidJSURL12cachesScript8idleTime17maxCachedDiagrams0K10CacheBytesACSg10Foundation3URLV_SbSdS2itcfc","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"mermaidJSURL"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cachesScript"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"idleTime"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxCachedDiagrams"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxCacheBytes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"modules":[{"name":"MarkdownKit"}],"role":"symbol","roleHeading":"Initializer","symbolKind":"init","title":"init(mermaidJSURL:cachesScript:idleTime:maxCachedDiagrams:maxCacheBytes:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"convenience"},{"kind":"text","text":" "},{"kind":"keyword","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"mermaidJSURL"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cachesScript"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":" = true, "},{"kind":"externalParam","text":"idleTime"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":" = MermaidRenderer.defaultIdleTime, "},{"kind":"externalParam","text":"maxCachedDiagrams"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = MermaidRenderer.defaultMaxCachedDiagrams, "},{"kind":"externalParam","text":"maxCacheBytes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = MermaidRenderer.defaultMaxCacheBytes)"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The location of the JavaScript library.","type":"text"}],"type":"paragraph"}],"name":"mermaidJSURL"},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (the default), the library is read once and kept in memory","type":"text"},{"text":" ","type":"text"},{"text":"(about 3.6 MB for ","type":"text"},{"code":"mermaid.min.js","type":"codeVoice"},{"text":") for as long as the renderer exists.","type":"text"},{"text":" ","type":"text"},{"text":"This makes creating the web view, which happens for the first diagram","type":"text"},{"text":" ","type":"text"},{"text":"and again after the web view was released or failed, a little faster.","type":"text"},{"text":" ","type":"text"},{"text":"If ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", the file is read every time a web view is created, and","type":"text"},{"text":" ","type":"text"},{"text":"nothing is kept in memory.","type":"text"}],"type":"paragraph"}],"name":"cachesScript"},{"content":[{"inlineContent":[{"text":"The time in seconds after which the web view is released if no diagram","type":"text"},{"text":" ","type":"text"},{"text":"is being rendered. That frees the memory of the web view and of its web","type":"text"},{"text":" ","type":"text"},{"text":"content process; the next diagram needs a new web view, which makes it","type":"text"},{"text":" ","type":"text"},{"text":"take a few hundred milliseconds longer. 0 (or less) releases the web view","type":"text"},{"text":" ","type":"text"},{"text":"as soon as no request is waiting for it, ","type":"text"},{"code":".infinity","type":"codeVoice"},{"text":" never releases it.","type":"text"},{"text":" ","type":"text"},{"text":"The default is ","type":"text"},{"code":"defaultIdleTime","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"idleTime"},{"content":[{"inlineContent":[{"text":"The maximal number of results that are cached, i.e. rendered","type":"text"},{"text":" ","type":"text"},{"text":"diagrams and diagrams which Mermaid rejected. When there are more, the","type":"text"},{"text":" ","type":"text"},{"text":"ones which were used least recently are dropped. At least 1; the default","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"defaultMaxCachedDiagrams","type":"codeVoice"},{"text":". ","type":"text"},{"code":"AttributedStringGenerator.generate(doc:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"only shows the diagrams that are in the cache, so it should be at least","type":"text"},{"text":" ","type":"text"},{"text":"the number of diagrams in the largest document that is displayed with","type":"text"},{"text":" ","type":"text"},{"text":"it; the diagrams of a document that does not fit are not all shown.","type":"text"},{"text":" ","type":"text"},{"code":"generateAsync","type":"codeVoice"},{"text":" does not depend on the size of the cache.","type":"text"}],"type":"paragraph"}],"name":"maxCachedDiagrams"},{"content":[{"inlineContent":[{"text":"The maximal total size of the cached PNG images in bytes (a diagram","type":"text"},{"text":" ","type":"text"},{"text":"typically takes between 10 and 200 KB). When it is exceeded, the images","type":"text"},{"text":" ","type":"text"},{"text":"which were used least recently are dropped; the last diagram that was","type":"text"},{"text":" ","type":"text"},{"text":"added is kept even if it is larger. At least 1; the default is","type":"text"},{"text":" ","type":"text"},{"code":"defaultMaxCacheBytes","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"maxCacheBytes"}]},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"A renderer, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the file cannot be read or the platform does not","type":"text"},{"text":" ","type":"text"},{"text":"support rendering diagrams.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/MermaidRenderer":{"abstract":[{"text":"Turns ","type":"text"},{"identifier":"https://mermaid.js.org","isActive":true,"type":"reference"},{"text":" diagram descriptions into images.","type":"text"}],"fragments":[{"kind":"keyword","tex