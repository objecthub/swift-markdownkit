{"abstract":[{"code":"ExtendedMarkdownParser","type":"codeVoice"},{"text":" objects are used to parse Markdown text represented as a string","type":"text"},{"text":" ","type":"text"},{"text":"using all extensions to the CommonMark specification implemented by MarkdownKit.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser"},"kind":"symbol","metadata":{"externalID":"s:11MarkdownKit08ExtendedA6ParserC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExtendedMarkdownParser"}],"modules":[{"name":"MarkdownKit"}],"navigatorTitle":[{"kind":"identifier","text":"ExtendedMarkdownParser"}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"ExtendedMarkdownParser"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExtendedMarkdownParser"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc://MarkdownKit/documentation/MarkdownKit/ChoosingAParser","doc://MarkdownKit/documentation/MarkdownKit/ConfiguringTheParser","doc://MarkdownKit/documentation/MarkdownKit/UnderstandingTheSyntaxTree","doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently"]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"ExtendedMarkdownParser","type":"codeVoice"},{"text":" object itself defines the configuration of the parser.","type":"text"},{"text":" ","type":"text"},{"text":"It is stateless in the sense that it can be used for parsing many input strings. This","type":"text"},{"text":" ","type":"text"},{"text":"is done via the ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" function. ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" returns an abstract syntax tree representing","type":"text"},{"text":" ","type":"text"},{"text":"the Markdown text for the given input string.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" method of the ","type":"text"},{"code":"ExtendedMarkdownParser","type":"codeVoice"},{"text":" object delegates parsing of the input","type":"text"},{"text":" ","type":"text"},{"text":"string to two types of processors: a ","type":"text"},{"code":"BlockParser","type":"codeVoice"},{"text":" object and an ","type":"text"},{"code":"InlineTransformer","type":"codeVoice"},{"text":" ","type":"text"},{"text":"object. A ","type":"text"},{"code":"BlockParser","type":"codeVoice"},{"text":" parses the Markdown block structure returning an abstract","type":"text"},{"text":" ","type":"text"},{"text":"syntax tree ignoring inline markup. An ","type":"text"},{"code":"InlineTransformer","type":"codeVoice"},{"text":" object is used to parse","type":"text"},{"text":" ","type":"text"},{"text":"a particular type of inline markup within text of Markdown blocks, replacing the","type":"text"},{"text":" ","type":"text"},{"text":"matching text with an abstract syntax tree representing the markup.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" method of ","type":"text"},{"code":"ExtendedMarkdownParser","type":"codeVoice"},{"text":" operates in two phases: in the first","type":"text"},{"text":" ","type":"text"},{"text":"phase, the block structure of an input string is identified via the ","type":"text"},{"code":"BlockParser","type":"codeVoice"},{"text":"s.","type":"text"},{"text":" ","type":"text"},{"text":"In the second phase, the block structure gets traversed and markup within raw text","type":"text"},{"text":" ","type":"text"},{"text":"gets replaced with a structured representation.","type":"text"}],"type":"paragrap