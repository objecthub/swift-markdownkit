{"abstract":[{"text":"Convert a parsed Markdown document into HTML, attributed strings, plain text or text for ANSI terminals.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/GeneratingOutput"},"kind":"article","metadata":{"modules":[{"name":"MarkdownKit"}],"role":"article","roleHeading":"Article","title":"Generating Output"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"MarkdownKit provides several ","type":"text"},{"inlineContent":[{"text":"generators","type":"text"}],"type":"emphasis"},{"text":", i.e. Markdown processors which output, for a given Markdown document, a corresponding representation in a different format:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Generator","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Output","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use it for","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"HTML as a ","type":"text"},{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"web pages, and as the basis for attributed strings","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NSAttributedString","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"text views on macOS and iOS (see also ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/DisplayingMarkdownWithSwiftUI","isActive":true,"type":"reference"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/StringGenerator","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"formatted plain text","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"text editors, logs, plain text files","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"text marked up with ANSI escape codes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"ANSI-compliant terminals","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"All generators take a document that a parser returned: ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block/document(_:)","isActive":true,"type":"reference"},{"text":". They work with every parser, see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ChoosingAParser","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Generate-HTML","level":3,"text":"Generate HTML","type":"heading"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":" defines a simple mapping from Markdown into HTML. Here is an example for the usage of the generator:","type":"text"}],"type":"paragraph"},{"code":["let html = HtmlGenerator.standard.generate(doc: markdown)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"To omit raw HTML and unsafe links from the output, create the generator with ","type":"text"},{"code":"HtmlGenerator(safeMode: true)","type":"codeVoice"},{"text":", see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/RenderingUntrustedMarkdown","isActive":true,"type":"reference"},{"text":". Beyond that option, there are currently no means to customize ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":" other than subclassing; ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomizingHTMLOutput","isActive":true,"type":"reference"},{"text":" shows how.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Fenced code blocks with the language ","type":"text"},{"code":"mermaid","type":"codeVoice"},{"text":" are ","type":"text"},{"identifier":"https://mermaid.js.org","isActive":true,"type":"reference"},{"text":" diagrams. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":" passes them on in a ","type":"text"},{"code":"<pre class=\"mermaid\">","type":"codeVoice"},{"text":" element for web pages that load Mermaid.","type":"text"}],"type":"paragraph"},{"anchor":"Generate-attributed-strings","level":3,"text":"Generate attributed strings","type":"heading"},{"inlineContent":[{"text":"MarkdownKit also comes with a generator for attributed strings. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":" uses a customized HTML generator internally to define the translation from Markdown into ","type":"text"},{"code":"NSAttributedString","type":"codeVoice"},{"text":". The initializer of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":" provides a number of parameters for customizing the style of the generated attributed string:","type":"text"}],"type":"paragraph"},{"code":["let generator = AttributedStringGenerator(fontSize: 12,","                                          fontFamily: \"Helvetica, sans-serif\",","                                          fontColor: \"#33C\",","                                          h1Color: \"#000\")","let attributedStr = generator.generate(doc: markdown)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Alternatively, it is also possible to subclass the internal HTML generator and customize the output this way. For the implementation of syntax highlighting in code blocks, ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":" uses ","type":"text"},{"identifier":"https://github.com/highlightjs/highlight.js/","isActive":true,"type":"reference"},{"text":"; see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighting","isActive":true,"type":"reference"},{"text":". ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomizingAttributedStringOutput","isActive":true,"type":"reference"},{"text":" covers the styling options in detail.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The generated HTML is rendered into an ","type":"text"},{"code":"NSAttributedString","type":"codeVoice"},{"text":" by the system. Use ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/RenderingOptions-swift.struct","isActive":true,"type":"reference"},{"text":" to configure it. ","type":"text"},{"code":"baseUrl","type":"codeVoice"},{"text":" is the base for resolving relative URLs (e.g. relative image paths) in the generated HTML. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/generate(doc:)","isActive":true,"type":"reference"},{"text":" renders synchronously on the calling thread; ","type":"text"},{"code":"generateAsync(doc:)","type":"codeVoice"},{"text":" is an alternative based on ","type":"text"},{"code":"NSAttributedString.loadFromHTML","type":"codeVoice"},{"text":" which does not block the calling thread. It throws an ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/RenderingError","isActive":true,"type":"reference"},{"text":" (e.g. ","type":"text"},{"code":".timedOut","type":"codeVoice"},{"text":" if the render takes longer than ","type":"text"},{"code":"timeout","type":"codeVoice"},{"text":" seconds, or ","type":"text"},{"code":".cancelled","type":"codeVoice"},{"text":"). It is available on macOS and iOS; on other platforms it throws ","type":"text"},{"code":".unsupportedPlatform","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let options = AttributedStringGenerator.RenderingOptions(","                baseUrl: URL(fileURLWithPath: \"/path/to/images\", isDirectory: true),","                timeout: 10)","let generator = AttributedStringGenerator(renderingOptions: options)","let attributedStr = generator.generate(doc: markdown)               // synchronous","let asyncStr = try await generator.generateAsync(doc: markdown)     // asynchronous"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For code that does not use Swift concurrency, there are variants with a completion handler. The handler is called exactly once, asynchronously, and always on the main thread; it receives a ","type":"text"},{"code":"Result","type":"codeVoice"},{"text":" with either the attributed string or a ","type":"text"},{"code":"RenderingError","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["generator.generateAsync(doc: markdown) { result in","  switch result {","    case .success(let attributedStr):","      textView.textStorage.setAttributedString(attributedStr)","    case .failure(let error):","      print(\"cannot convert: \\(error)\")","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Do not use ","type":"text"},{"code":"generateAsync","type":"codeVoice"},{"text":" with untrusted Markdown without restricting what it may load, because it loads remote resources that the HTML refers to. See ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/RenderingUntrustedMarkdown","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Generate-plain-text-and-terminal-output","level":3,"text":"Generate plain text and terminal output","type":"heading"},{"inlineContent":[{"text":"There are two generators for outputting formatted text. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/StringGenerator","isActive":true,"type":"reference"},{"text":" formats text based on the given Markdown and returns text that can be, e.g. edited in a text editor. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator","isActive":true,"type":"reference"},{"text":" formats text for output in an ANSI-compliant terminal, using control sequences to mark up the text. Both wrap text to a number of columns:","type":"text"}],"type":"paragraph"},{"code":["print(StringGenerator(numColumns: 60).generate(doc: markdown))","print(TerminalGenerator(numColumns: 60).generate(doc: markdown).encodedString)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/GeneratingTerminalOutput","isActive":true,"type":"reference"},{"text":" for tables, styles and customization.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator":{"abstract":[{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into","type":"text"},{"text":" ","type":"text"},{"code":"NSAttributedString","type":"codeVoice"},{"text":" objects that are used in macOS and iOS for displaying rich text.","type":"text"},{"text":" ","type":"text"},{"text":"The implementation is extensible allowing subclasses of ","type":"text"},{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"override how individual Markdown structures are converted into attributed strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AttributedStringGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AttributedStringGenerator"}],"role":"symbol","title":"AttributedStringGenerator","type":"topic","url":"/documentation/markdownkit/attributedstringgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/RenderingError":{"abstract":[{"text":"Errors thrown by ","type":"text"},{"code":"generateAsync","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderingError"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/RenderingError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RenderingError"}],"role":"symbol","title":"AttributedStringGenerator.RenderingError","type":"topic","url":"/documentation/markdownkit/attributedstringgenerator/renderingerror"},"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/RenderingOptions-swift.struct":{"abstract":[{"text":"Options for rendering the HTML that ","type":"text"},{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" generates into an","type":"text"},{"text":" ","type":"text"},{"code":"NSAttributedString","type":"codeVoice"},{"text":". They are used by the synchronous methods (","type":"text"},{"code":"generate(doc:)","type":"codeVoice"},{"text":" etc.) as","type":"text"},{"text":" ","type":"text"},{"text":"well as by the asynchronous ones (","type":"text"},{"code":"generateAsync(doc:)","type":"codeVoice"},{"text":" etc.).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderingOptions"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/RenderingOptions-swift.struct","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RenderingOptions"}],"role":"symbol","title":"AttributedStringGenerator.RenderingOptions","type":"topic","url":"/documentation/markdownkit/attributedstringgenerator/renderingoptions-swift.struct"},"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/generate(doc:)":{"abstract":[{"text":"Generates an attributed string from the given Markdown document.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"generate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"doc"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit5BlockO","text":"Block"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSAttributedString","text":"NSAttributedString"},{"kind":"text","text":"?"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/generate(doc:)","kind":"symbol","role":"symbol","title":"generate(doc:)","type":"topic","url":"/documentation/markdownkit/attributedstringgenerator/generate(doc:)"},"doc://MarkdownKit/documentation/MarkdownKit/Block/document(_:)":{"abstract":[{"text":"The root of a document: the sequence of its top-level blocks.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"document"},{"kind":"text","text":"("},{"kind":"typeIdentifier