t to light and dark mode.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/DisplayingMarkdownWithSwiftUI","kind":"article","role":"article","title":"Displaying Markdown with SwiftUI","type":"topic","url":"/documentation/markdownkit/displayingmarkdownwithswiftui"},"doc://MarkdownKit/documentation/MarkdownKit/GeneratingTerminalOutput":{"abstract":[{"text":"Format Markdown documents as plain text, or as text with ANSI styling for terminals.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/GeneratingTerminalOutput","kind":"article","role":"article","title":"Generating Plain Text and Terminal Output","type":"topic","url":"/documentation/markdownkit/generatingterminaloutput"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator":{"abstract":[{"code":"HtmlGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into HTML. The","type":"text"},{"text":" ","type":"text"},{"text":"implementation is extensible allowing subclasses of ","type":"text"},{"code":"HtmlGenerator","type":"codeVoice"},{"text":" to override how","type":"text"},{"text":" ","type":"text"},{"text":"individual Markdown structures are converted into HTML.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"HtmlGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HtmlGenerator"}],"role":"symbol","title":"HtmlGenerator","type":"topic","url":"/documentation/markdownkit/htmlgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/ProcessingMarkdown":{"abstract":[{"text":"Walk the abstract syntax tree of a parsed document to extract information or to transform it.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ProcessingMarkdown","kind":"article","role":"article","title":"Processing Markdown","type":"topic","url":"/documentation/markdownkit/processingmarkdown"},"doc://MarkdownKit/documentation/MarkdownKit/Recipes":{"abstract":[{"text":"Solve common tasks with a few lines of MarkdownKit.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Recipes","kind":"article","role":"article","title":"Recipes","type":"topic","url":"/documentation/markdownkit/recipes"},"doc://MarkdownKit/documentation/MarkdownKit/RenderingUntrustedMarkdown":{"abstract":[{"text":"Restrict what raw HTML, links and images in a document may do when the Markdown does not come from you.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/RenderingUntrustedMarkdown","kind":"article","role":"article","title":"Rendering Untrusted Markdown","type":"topic","url":"/documentation/markdownkit/renderinguntrustedmarkdown"},"doc://MarkdownKit/documentation/MarkdownKit/StringGenerator":{"abstract":[{"code":"StringGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into formatted","type":"text"},{"text":" ","type":"text"},{"text":"plain text strings with word wrapping and indentation support. The implementation is","type":"text"},{"text":" ","type":"text"},{"text":"extensible allowing subclasses of ","type":"text"},{"code":"StringGenerator","type":"codeVoice"},{"text":" to override how individual Markdown","type":"text"},{"text":" ","type":"text"},{"text":"structures are converted into strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"StringGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/StringGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"StringGenerator"}],"role":"symbol","title":"StringGenerator","type":"topic","url":"/documentation/markdownkit/stringgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighting":{"abstract":[{"text":"Color the code of fenced code blocks in attributed strings and terminal output, or highlight code on its own.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighting","kind":"article","role":"article","title":"Highlighting Code","type":"topic","url":"/documentation/markdownkit/syntaxhighlighting"},"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator":{"abstract":[{"code":"TerminalGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into text for","type":"text"},{"text":" ","type":"text"},{"text":"ANSI-compliant terminals, with word wrapping, indentation, and styled text. The result is","type":"text"},{"text":" ","type":"text"},{"text":"marked up with ANSI escape sequences. The implementation is extensible allowing subclasses","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"TerminalGenerator","type":"codeVoice"},{"text":" to override how individual Markdown structures are converted into","type":"text"},{"text":" ","type":"text"},{"text":"styled text.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TerminalGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TerminalGenerator"}],"role":"symbol","title":"TerminalGenerator","type":"topic","url":"/documentation/markdownkit/terminalgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/UsingTheCommandLineTools":{"abstract":[{"text":"Convert Markdown files from the terminal and preview the text generators.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/UsingTheCommandLineTools","kind":"article","role":"article","title":"Using the Command-Line Tools","type":"topic","url":"/documentation/markdownkit/usingthecommandlinetools"},"https://github.com/highlightjs/highlight.js/":{"identifier":"https://github.com/highlightjs/highlight.js/","title":"Highlight.js","titleInlineContent":[{"text"