{"abstract":[{"text":"Pick the parser class that supports the Markdown syntax your documents use.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/ChoosingAParser"},"kind":"article","metadata":{"modules":[{"name":"MarkdownKit"}],"role":"article","roleHeading":"Article","title":"Choosing a Parser"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"MarkdownKit has five parser classes. They share the same interface and differ in the syntax they recognize. Each one extends the previous one:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Parser","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Syntax","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"https://commonmark.org","isActive":true,"type":"reference"},{"text":" 0.31.2: headings, paragraphs, block quotes, lists, code blocks, thematic breaks, HTML, links, images, emphasis, code spans and line breaks","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"everything in ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","isActive":true,"type":"reference"},{"text":" plus tables and definition lists","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"everything in ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"},{"text":" plus underlined text, struck-through text and task lists","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathMarkdownParser","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"everything in ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"},{"text":" plus LaTeX math between dollar signs, see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathematicalFormulas","isActive":true,"type":"reference"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/LaTeXMarkdownParser","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"everything in ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathMarkdownParser","isActive":true,"type":"reference"},{"text":" plus the delimiters of LaTeX for math: ","type":"text"},{"code":"\\(a^2\\)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"\\[a^2\\]","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect","isActive":true,"type":"reference"},{"text":" names the five syntaxes (","type":"text"},{"code":".commonMark","type":"codeVoice"},{"text":", ","type":"text"},{"code":".extendedCommonMark","type":"codeVoice"},{"text":", ","type":"text"},{"code":".full","type":"codeVoice"},{"text":", ","type":"text"},{"code":".fullMath","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".fullLaTeX","type":"codeVoice"},{"text":") and gives access to their standard parsers, so that code which chooses a syntax at run time, such as the initializers of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownText","isActive":true,"type":"reference"},{"text":", does not have to know the classes:","type":"text"}],"type":"paragraph"},{"code":["let doc = MarkdownDialect.fullMath.parser.parse(\"The area is $\\\\pi r^2$.\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each class has a shared instance, e.g. ","type":"text"},{"code":"FullMarkdownParser.standard","type":"codeVoice"},{"text":". Parsers do not have mutable state, so one instance can parse many documents. Further markup will be added to ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"},{"text":", except for markup that changes the meaning of characters which are common in text, such as the dollar sign in ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathMarkdownParser","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Tables-and-definition-lists","level":3,"text":"Tables and definition lists","type":"heading"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"},{"text":" supports tables and definition lists in addition to the block types defined by the ","type":"text"},{"identifier":"https://commonmark.org","isActive":true,"overridingTitle":"CommonMark specification","overridingTitleInlineContent":[{"text":"CommonMark specification","type":"text"}],"type":"reference"},{"text":". ","type":"text"},{"identifier":"https://github.github.com/gfm/#tables-extension-","isActive":true,"type":"reference"},{"text":" are based on the ","type":"text"},{"identifier":"https://github.github.com/gfm/","isActive":true,"type":"reference"},{"text":" with one extension: within a table block, it is possible to escape newline characters to enable cell text to be written on multiple lines. Here is an example:","type":"text"}],"type":"paragraph"},{"code":["| Column 1     | Column 2       |","| ------------ | -------------- |","| This text \\","  is very long | More cell text |","| Last line    | Last cell      |"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"A table becomes the syntax tree case ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block/table(_:_:_:)","isActive":true,"type":"reference"},{"text":". ","type":"text"},{"identifier":"https://www.markdownguide.org/extended-syntax/#definition-lists","isActive":true,"type":"reference"},{"text":" are implemented in an ad hoc fashion. A definition consists of terms and their corresponding definitions; the syntax tree case is ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block/definitionList(_:)","isActive":true,"type":"reference"},{"text":". Here is an example of two definitions:","type":"text"}],"type":"paragraph"},{"code":["Apple",": Pomaceous fruit of plants of the genus Malus in the family Rosaceae.","","Orange",": The fruit of an evergreen tree of the genus Citrus.",": A large round juicy citrus fruit with a tough bright reddish-yellow rind."],"syntax":null,"type":"codeListing"},{"anchor":"Underline-strikethrough-and-task-lists","level":3,"text":"Underline, strikethrough and task lists","type":"heading"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"},{"text":" supports everything that MarkdownKit implements. It is a subclass of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"},{"text":" (so it supports tables and definition lists) and adds:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Inline markup for underlined text (","type":"text"},{"code":"~underlined~","type":"codeVoice"},{"text":", text fragment ","type":"text"},{"code":"underline","type":"codeVoice"},{"text":") and struck-through text (","type":"text"},{"code":"~~struck through~~","type":"codeVoice"},{"text":", text fragment ","type":"text"},{"code":"strikethrough","type":"codeVoice"},{"text":"). Tildes can also be used within words (","type":"text"},{"code":"foo~~bar~~baz","type":"codeVoice"},{"text":"), but runs of three or more tildes are plain text, as in GitHub Flavored Markdown. Unlike GFM, a single tilde does not produce strikethrough but underlined text.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Task list items (","type":"text"},{"code":"- [ ] to do","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"- [x] done","type":"codeVoice"},{"text":", list type ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/task(_:checked:)","isActive":true,"type":"reference"},{"text":"). A task list item is a list item whose text starts with ","type":"text"},{"code":"[ ]","type":"codeVoice"},{"text":", ","type":"text"},{"code":"[x]","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[X]","type":"codeVoice"},{"text":" and a space or tab; the type of such an item wraps the bullet or number of the item.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The HTML generator creates a checkbox for a task list item, the attributed string generator uses the characters ☐ and ☑, and the text generators write ","type":"text"},{"code":"[ ]","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"[x]","type":"codeVoice"},{"text":" instead of the bullet.","type":"text"}],"type":"paragraph"},{"code":["let markdown = FullMarkdownParser.standard.parse(\"Some ~~old~~ and ~important~ text\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"},{"text":" do not know this markup and leave tildes as they are, so existing code does not change its behavior.","type":"text"}],"type":"paragraph"},{"anchor":"Handle-every-case-when-you-switch-over-a-syntax-tree","level":3,"text":"Handle every case when you switch over a syntax tree","type":"heading"},{"inlineContent":[{"text":"Documents parsed by ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"},{"text":" contain the cases ","type":"text"},{"code":"underline","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"strikethrough","type":"codeVoice"},{"text":" of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TextFragment","isActive":true,"type":"reference"},{"text":" and the list type ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/task(_:checked:)","isActive":true,"type":"reference"},{"text":". A ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over these enumerations has to handle them. Use ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/marker","isActive":true,"type":"reference"},{"text":" to get the bullet or number of a list item, whether or not it is a task item.","type":"text"}],"type":"paragraph"},{"anchor":"Mathematical-formulas","level":3,"text":"Mathematical formulas","type":"heading"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathMarkdownParser","isActive":true,"type":"reference"},{"text":" is a subclass of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"},{"text":" which also recognizes LaTeX math: ","type":"text"},{"code":"$a^2$","type":"codeVoice"},{"text":" within a line, and ","type":"text"},{"code":"$$","type":"codeVoice"},{"text":" on its own lines or a fenced code block with the info string ","type":"text"},{"code":"math","type":"codeVoice"},{"text":" for a formula that is a block. Dollar signs are common in text (","type":"text"},{"code":"costs $5 and $6","type":"codeVoice"},{"text":"), so the other parsers leave them alone. The formulas are custom syntax tree nodes (","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathFragment","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathBlock","isActive":true,"type":"reference"},{"text":"), so a ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TextFragment","isActive":true,"type":"reference"},{"text":" is not affected: they are handled by the ","type":"text"},{"code":"custom","type":"codeVoice"},{"text":" cases. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/LaTeXMarkdownParser","isActive":true,"type":"reference"},{"text":" also recognizes the delimiters ","type":"text"},{"code":"\\(a^2\\)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"\\[a^2\\]","type":"codeVoice"},{"text":", which are escaped characters in Markdown and therefore change the meaning of existing text. See ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathematicalFormulas","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator":{"abstract":[{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into","type":"text"},{"text":" ","type":"text"},{"code":"NSAttributedString","type":"codeVoice"},{"text":" objects that are used in macOS and iOS for displaying rich text.","type":"text"},{"text":" ","type":"text"},{"text":"The implementation is extensible allowing subclasses of ","type":"text"},{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"override how individual Markdown structures are converted into attributed strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AttributedStringGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AttributedStringGenerator"}],"role":"symbol","title":"AttributedStringGenerator","type":"topic","url":"/documentation/markdownkit/attributedstringgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/Block":{"abstract":[{"text":"Enumeration of Markdown blocks. This enumeration defines the block structure,","type":"text"},{"text":" ","type":"text"},{"text":"i.e. the abstract syntax, of Markdown supported by MarkdownKit. The structure of","type":"text"},{"text":" ","type":"text"},{"text":"inline text is defined by the ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Text","isActive":true,"type":"reference"},{"text":" struct.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Block"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Block"}],"role":"symbol","title":"Block","type":"topic","url":"/documentation/markdownkit/block"},"doc://MarkdownKit/documentation/MarkdownKit/Block/definitionList(_