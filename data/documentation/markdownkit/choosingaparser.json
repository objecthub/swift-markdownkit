{"abstract":[{"text":"Pick the parser class that supports the Markdown syntax your documents use.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/ChoosingAParser"},"kind":"article","metadata":{"modules":[{"name":"MarkdownKit"}],"role":"article","roleHeading":"Article","title":"Choosing a Parser"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"MarkdownKit has three parser classes. They share the same interface and differ in the syntax they recognize. Each one extends the previous one:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Parser","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Syntax","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"https://commonmark.org","isActive":true,"type":"reference"},{"text":" 0.31.2: headings, paragraphs, block quotes, lists, code blocks, thematic breaks, HTML, links, images, emphasis, code spans and line breaks","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"everything in ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","isActive":true,"type":"reference"},{"text":" plus tables and definition lists","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"everything in ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"},{"text":" plus underlined text, struck-through text and task lists","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Each class has a shared instance, e.g. ","type":"text"},{"code":"FullMarkdownParser.standard","type":"codeVoice"},{"text":". Parsers do not have mutable state, so one instance can parse many documents. New Markdown features will be added to ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Tables-and-definition-lists","level":3,"text":"Tables and definition lists","type":"heading"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"},{"text":" supports tables and definition lists in addition to the block types defined by the ","type":"text"},{"identifier":"https://commonmark.org","isActive":true,"overridingTitle":"CommonMark specification","overridingTitleInlineContent":[{"text":"CommonMark specification","type":"text"}],"type":"reference"},{"text":". ","type":"text"},{"identifier":"https://github.github.com/gfm/#tables-extension-","isActive":true,"type":"reference"},{"text":" are based on the ","type":"text"},{"identifier":"https://github.github.com/gfm/","isActive":true,"type":"reference"},{"text":" with one extension: within a table block, it is possible to escape newline characters to enable cell text to be written on multiple lines. Here is an example:","type":"text"}],"type":"paragraph"},{"code":["| Column 1     | Column 2       |","| ------------ | -------------- |","| This text \\","  is very long | More cell text |","| Last line    | Last cell      |"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"A table becomes the syntax tree case ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block/table(_:_:_:)","isActive":true,"type":"reference"},{"text":". ","type":"text"},{"identifier":"https://www.markdownguide.org/extended-syntax/#definition-lists","isActive":true,"type":"reference"},{"text":" are implemented in an ad hoc fashion. A definition consists of terms and their corresponding definitions; the syntax tree case is ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block/definitionList(_:)","isActive":true,"type":"reference"},{"text":". Here is an example of two definitions:","type":"text"}],"type":"paragraph"},{"code":["Apple",": Pomaceous fruit of plants of the genus Malus in the family Rosaceae.","","Orange",": The fruit of an evergreen tree of the genus Citrus.",": A large round juicy citrus fruit with a tough bright reddish-yellow rind."],"syntax":null,"type":"codeListing"},{"anchor":"Underline-strikethrough-and-task-lists","level":3,"text":"Underline, strikethrough and task lists","type":"heading"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"},{"text":" supports everything that MarkdownKit implements. It is a subclass of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"},{"text":" (so it supports tables and definition lists) and adds:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Inline markup for underlined text (","type":"text"},{"code":"~underlined~","type":"codeVoice"},{"text":", text fragment ","type":"text"},{"code":"underline","type":"codeVoice"},{"text":") and struck-through text (","type":"text"},{"code":"~~struck through~~","type":"codeVoice"},{"text":", text fragment ","type":"text"},{"code":"strikethrough","type":"codeVoice"},{"text":"). Tildes can also be used within words (","type":"text"},{"code":"foo~~bar~~baz","type":"codeVoice"},{"text":"), but runs of three or more tildes are plain text, as in GitHub Flavored Markdown. Unlike GFM, a single tilde does not produce strikethrough but underlined text.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Task list items (","type":"text"},{"code":"- [ ] to do","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"- [x] done","type":"codeVoice"},{"text":", list type ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/task(_:checked:)","isActive":true,"type":"reference"},{"text":"). A task list item is a list item whose text starts with ","type":"text"},{"code":"[ ]","type":"codeVoice"},{"text":", ","type":"text"},{"code":"[x]","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[X]","type":"codeVoice"},{"text":" and a space or tab; the type of such an item wraps the bullet or number of the item.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The HTML generator creates a checkbox for a task list item, the attributed string generator uses the characters ☐ and ☑, and the text generators write ","type":"text"},{"code":"[ ]","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"[x]","type":"codeVoice"},{"text":" instead of the bullet.","type":"text"}],"type":"paragraph"},{"code":["let markdown = FullMarkdownParser.standard.parse(\"Some ~~old~~ and ~important~ text\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"},{"text":" do not know this markup and leave tildes as they are, so existing code does not change its behavior.","type":"text"}],"type":"paragraph"},{"anchor":"Handle-every-case-when-you-switch-over-a-syntax-tree","level":3,"text":"Handle every case when you switch over a syntax tree","type":"heading"},{"inlineContent":[{"text":"Documents parsed by ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"},{"text":" contain the cases ","type":"text"},{"code":"underline","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"strikethrough","type":"codeVoice"},{"text":" of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TextFragment","isActive":true,"type":"reference"},{"text":" and the list type ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/task(_:checked:)","isActive":true,"type":"reference"},{"text":". A ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" over these enumerations has to handle them. Use ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/marker","isActive":true,"type":"reference"},{"text":" to get the bullet or number of a list item, whether or not it is a task item.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/Block/definitionList(_:)":{"abstract":[{"text":"A list of definitions, each with a term and one or more descriptions.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"definitionList"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit11Definitionsa","text":"Definitions"},{"kind":"text","text":")"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block/definitionList(_:)","kind":"symbol","role":"symbol","title":"Block.definitionList(_:)","type":"topic","url":"/documentation/markdownkit/block/definitionlist(_:)"},"doc://MarkdownKit/documentation/MarkdownKit/Block/table(_:_:_:)":{"abstract":[{"text":"A table. The first parameter is the header row, the second parameter has the alignment of","type":"text"},{"text":" ","type":"text"},{"text":"each column, and the third parameter contains the body rows. Each row has a cell for","type":"text"},{"text":" ","type":"text"},{"text":"each column.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"table"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit3Rowa","text":"Row"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit10Alignmentsa","text":"Alignments"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit4Rowsa","text":"Rows"},{"kind":"text","text":")"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block/table(_:_:_:)","kind":"symbol","role":"symbol","title":"Block.table(_:_:_:)","type":"topic","url":"/documentation/markdownkit/block/table(_:_:_:)"},"doc://MarkdownKit/documentation/MarkdownKit/ConfiguringTheParser":{"abstract":[{"text":"Change which Markdown syntax a parser understands by choosing its block parsers and inline transformers.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ConfiguringTheParser","kind":"article","role":"article","title":"Configuring the Parser","type":"topic","url":"/documentation/markdownkit/configuringtheparser"},"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser":{"abstract":[{"code":"ExtendedMarkdownParser","type":"codeVoice"},{"text":" objects are used to parse Markdown text represented as a string","type":"text"},{"text":" ","type":"text"},{"text":"using all extensions to the CommonMark specification implemented by MarkdownKit.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExtendedMarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ExtendedMarkdownParser"}],"role":"symbol","title":"ExtendedMarkdownParser","type":"topic","url":"/documentation/markdownkit/extendedmarkdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser":{"abstract":[{"text":"Add your own inline markup to the Markdown syntax that MarkdownKit supports.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser","kind":"article","role":"article","title":"Extending the Parser","type":"topic","url":"/documentation/markdownkit/extendingtheparser"},"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser":{"abstract":[{"code":"FullMarkdownParser","type":"codeVoice"},{"text":" objects are used to parse Markdown text represented as a string using","type":"text"},{"text":" ","type":"text"},{"text":"all features of MarkdownKit: the syntax of the CommonMark specification and all extensions","type":"text"},{"text":" ","type":"text"},{"text":"that MarkdownKit implements.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FullMarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"FullMarkdownParser"}],"role":"symbol","title":"FullMarkdownParser","type":"topic","url":"/documentation/markdownkit/fullmarkdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/ListType/marker":{"abstract":[{"text":"The list type without the checkbox of a task list item: the ","type":"text"},{"code":"bullet","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"ordered","type":"codeVoice"},{"text":" list","type":"text"},{"text":" ","type":"text"},{"text":"type for a task list item, and the list type itself for all other list types.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"marker"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit8ListTypeO","text":"ListType"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/marker","kind":"symbol","role":"symbol","title":"marker","type":"topic","url":"/documentation/markdownkit/listtype/marker"},"doc://MarkdownKit/documentation/MarkdownKit/ListType/task(_:checked:)":{"abstract":[{"text":"A task list item with a checkbox, which is checked if ","type":"text"},{"code":"checked","type":"codeVoice"},{"text":" is true. The first","type":"text"},{"text":" ","type":"text"},{"text":"parameter is the marker of the item (a ","type":"text"},{"code":"bullet","type":"codeVoice"},{"text":" or an ","type":"text"},{"code":"ordered","type":"codeVoice"},{"text":" list type).","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"task"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit8ListTypeO","text":"ListType"},{"kind":"text","text":", "},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/task(_:checked:)","kind":"symbol","role":"symbol","title":"ListType.task(_:checked:)","type":"topic","url":"/documentation/markdownkit/listtype/task(_:checked:)"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser":{"abstract":[{"code":"MarkdownParser","type":"codeVoice"},{"text":" objects are used to parse Markdown text represented as a string.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"MarkdownParser","type":"codeVoice"},{"text":" object itself defines the configuration of the parser. It is","type":"text"},{"text":" ","type":"text"},{"text":"stateless in the sense that it can be used for parsing many input strings. This is","type":"text"},{"text":" ","type":"text"},{"text":"done via the ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" function. ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" returns an abstract syntax tree representing","type":"text"},{"text":" ","type":"text"},{"text":"the Markdown text for the given input string.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MarkdownParser"}],"role":"symbol","title":"MarkdownParser","type":"topic","url":"/documentation/markdownkit/markdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/TextFragment":{"abstract":[{"text":"In MarkdownKit, text with markup is represented as a sequence of ","type":"text"},{"code":"TextFragment","type":"codeVoice"},{"text":" objects.","type":"text"},{"text":" ","type":"text"},{"text":"Each ","type":"text"},{"code":"TextFragment","type":"codeVoice"},{"text":" enumeration variant represents one form of inline markup. Since","type":"text"},{"text":" ","type":"text"},{"text":"markup can be arbitrarily nested, this is a recursive data structure (via struct ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TextFragment"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TextFragment","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TextFragment"}],"role":"symbol","title":"TextFragment","type":"topic","url":"/documentation/markdownkit/textfragment"},"https://commonmark.org":{"identifier":"https://commonmark.org","title":"CommonMark","titleInlineContent":[{"text":"CommonMark","type":"text"}],"type":"link","url":"https://commonmark.org"},"https://github.github.com/gfm/":{"identifier":"https://github.github.com/gfm/","title":"GitHub Flavored Markdown specification","titleInlineContent":[{"text":"GitHub Flavored Markdown specification","type":"text"}],"type":"link","url":"https://github.github.com/gfm/"},"https://github.github.com/gfm/#tables-extension-":{"identifier":"https://github.github.com/gfm/#tables-extension-","title":"Tables","titleInlineContent":[{"text":"Tables","type":"text"}],"type":"link","url":"https://github.github.com/gfm/#tables-extension-"},"https://www.markdownguide.org/extended-syntax/#definition-lists":{"identifier":"https://www.markdownguide.org/extended-syntax/#definition-lists","title":"Definition lists","titleInlineContent":[{"text":"Definition lists","type":"text"}],"type":"link","url":"https://www.markdownguide.org/extended-syntax/#definition-lists"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc://MarkdownKit/documentation/MarkdownKit/ConfiguringTheParser","doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser"],"title":"Related Documentation"},{"anchor":"Parsing-Markdown","generated":true,"identifiers":["doc://MarkdownKit/documentation/MarkdownKit/ConfiguringTheParser","doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser","doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser"],"title":"Parsing Markdown"}],"variants":[{"paths":["/documentation/markdownkit/choosingaparser"],"traits":[{"interfaceLanguage":"swift"}]}]}