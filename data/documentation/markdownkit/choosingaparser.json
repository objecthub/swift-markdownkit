nd":"article","role":"article","title":"Configuring the Parser","type":"topic","url":"/documentation/markdownkit/configuringtheparser"},"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser":{"abstract":[{"code":"ExtendedMarkdownParser","type":"codeVoice"},{"text":" objects are used to parse Markdown text represented as a string","type":"text"},{"text":" ","type":"text"},{"text":"using all extensions to the CommonMark specification implemented by MarkdownKit.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExtendedMarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ExtendedMarkdownParser"}],"role":"symbol","title":"ExtendedMarkdownParser","type":"topic","url":"/documentation/markdownkit/extendedmarkdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser":{"abstract":[{"text":"Add your own inline markup to the Markdown syntax that MarkdownKit supports.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser","kind":"article","role":"article","title":"Extending the Parser","type":"topic","url":"/documentation/markdownkit/extendingtheparser"},"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser":{"abstract":[{"code":"FullMarkdownParser","type":"codeVoice"},{"text":" objects are used to parse Markdown text represented as a string using","type":"text"},{"text":" ","type":"text"},{"text":"all features of MarkdownKit: the syntax of the CommonMark specification and all extensions","type":"text"},{"text":" ","type":"text"},{"text":"that MarkdownKit implements.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FullMarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"FullMarkdownParser"}],"role":"symbol","title":"FullMarkdownParser","type":"topic","url":"/documentation/markdownkit/fullmarkdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/LaTeXMarkdownParser":{"abstract":[{"code":"LaTeXMarkdownParser","type":"codeVoice"},{"text":" is a ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathMarkdownParser","isActive":true,"type":"reference"},{"text":" which also recognizes the delimiters of","type":"text"},{"text":" ","type":"text"},{"text":"LaTeX for formulas:","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LaTeXMarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/LaTeXMarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"LaTeXMarkdownParser"}],"role":"symbol","title":"LaTeXMarkdownParser","type":"topic","url":"/documentation/markdownkit/latexmarkdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/ListType/marker":{"abstract":[{"text":"The list type without the checkbox of a task list item: the ","type":"text"},{"code":"bullet","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"ordered","type":"codeVoice"},{"text":" list","type":"text"},{"text":" ","type":"text"},{"text":"type for a task list item, and the list type itself for all other list types.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"marker"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit8ListTypeO","text":"ListType"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/marker","kind":"symbol","role":"symbol","title":"marker","type":"topic","url":"/documentation/markdownkit/listtype/marker"},"doc://MarkdownKit/documentation/MarkdownKit/ListType/task(_:checked:)":{"abstract":[{"text":"A task list item with a checkbox, which is checked if ","type":"text"},{"code":"checked","type":"codeVoice"},{"text":" is true. The first","type":"text"},{"text":" ","type":"text"},{"text":"parameter is the marker of the item (a ","type":"text"},{"code":"bullet","type":"codeVoice"},{"text":" or an ","type":"text"},{"code":"ordered","type":"codeVoice"},{"text":" list type).","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"task"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit8ListTypeO","text":"ListType"},{"kind":"text","text":", "},{"kind":"externalParam","text":"checked"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/task(_:checked:)","kind":"symbol","role":"symbol","title":"ListType.task(_:checked:)","type":"topic","url":"/documentation/markdownkit/listtype/task(_:checked:)"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect":{"abstract":[{"text":"The Markdown dialects that MarkdownKit supports out of the box, each with its standard","type":"text"},{"text":" ","type":"text"},{"text":"parser. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownText","isActive":true,"type":"reference"},{"text":" uses a dialect to choose how it parses a string.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MarkdownDialect"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MarkdownDialect"}],"role":"symbol","title":"MarkdownDialect","type":"topic","url":"/documentation/markdownkit/markdowndialect"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser":{"abstract":[{"code":"MarkdownParser","type":"codeVoice"},{"text":" objects are used to parse Markdown text represented as a string.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"MarkdownParser","type":"codeVoice"},{"text":" object itself defines the configuration of the parser. It is","type":"text"},{"text":" ","type":"text"},{"text":"stateless in the sense that it can be used for parsing many input strings. This is","type":"text"},{"text":" ","type":"text"},{"text":"done via the ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" function. ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" returns an abstract syntax tree representing","type":"text"},{"text":" ","type":"text"},{"text":"the Markdown text for the given input string.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MarkdownParser"}],"role":"symbol","title":"MarkdownParser","type":"topic","url":"/documentation/markdownkit/markdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownText":{"abstract":[{"text":"A SwiftUI view that displays a Markdown document as formatted text. The view converts the","type":"text"},{"text":" ","type":"text"},{"text":"document into an attributed string with an ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":", using different","type":"text"},{"text":" ","type":"text"},{"text":"generators for light and dark mode, and shows the result in a read-only text view whose text","type":"text"},{"text":" ","type":"text"},{"text":"can be selected. The view scrolls vertically.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MarkdownText"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownText","kind":"symbol","navigatorTitle":[{"kind":"identifier","text