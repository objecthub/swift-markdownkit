{"abstract":[{"text":"Change the HTML that MarkdownKit generates by subclassing ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/CustomizingHTMLOutput"},"kind":"article","metadata":{"modules":[{"name":"MarkdownKit"}],"role":"article","roleHeading":"Article","title":"Customizing HTML Output"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Beyond the ","type":"text"},{"code":"safeMode","type":"codeVoice"},{"text":" option (see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/init(safeMode:)","isActive":true,"type":"reference"},{"text":"), there are currently no means to customize ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":" other than subclassing. The generator is a recursive traversal of the syntax tree with one method for each level, and a subclass overrides the methods for the elements it wants to change:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Called for","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(doc:)","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"the whole document","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(blocks:parent:tight:)","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"a sequence of blocks","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(block:parent:tight:)","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"one block","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(text:)","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"inline text","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(textFragment:)","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"one inline fragment","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Override a method, handle the cases that you want to change, and call ","type":"text"},{"code":"super","type":"codeVoice"},{"text":" for the others.","type":"text"}],"type":"paragraph"},{"anchor":"Change-how-a-block-is-generated","level":3,"text":"Change how a block is generated","type":"heading"},{"inlineContent":[{"text":"Here is an example that defines a customized HTML generator which formats ","type":"text"},{"code":"blockquote","type":"codeVoice"},{"text":" Markdown blocks using HTML tables:","type":"text"}],"type":"paragraph"},{"code":["open class CustomizedHtmlGenerator: HtmlGenerator, @unchecked Sendable {","  open override func generate(block: Block, parent: Parent, tight: Bool = false) -> String {","    switch block {","      case .blockquote(let blocks):","        return \"<table><tbody><tr><td style=\\\"background: #bbb; width: 0.2em;\\\"  />\" +","               \"<td style=\\\"width: 0.2em;\\\" /><td>\\n\" +","               self.generate(blocks: blocks, parent: .block(block, parent)) +","               \"</td></tr></tbody></table>\\n\"","      default:","        return super.generate(block: block, parent: parent, tight: tight)","    }","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When you generate the content of a block, pass ","type":"text"},{"code":".block(block, parent)","type":"codeVoice"},{"text":" as the parent, as above. The ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/Parent","isActive":true,"type":"reference"},{"text":" value tells a generator where a block appears: ","type":"text"},{"code":".none","type":"codeVoice"},{"text":" for a top-level block, and otherwise the enclosing block together with the blocks that enclose it. This example adds an anchor to top-level headings only:","type":"text"}],"type":"paragraph"},{"code":["final class AnchorHtmlGenerator: HtmlGenerator, @unchecked Sendable {","  override func generate(block: Block, parent: Parent, tight: Bool = false) -> String {","    if case .heading(let level, let text) = block, case .none = parent {","      let anchor = text.rawDescription.lowercased()","                       .split(whereSeparator: { !$0.isLetter && !$0.isNumber })","                       .joined(separator: \"-\")","      return \"<h\\(level) id=\\\"\\(anchor)\\\">\\(self.generate(text: text))</h\\(level)>\\n\"","    }","    return super.generate(block: block, parent: parent, tight: tight)","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"tight","type":"codeVoice"},{"text":" parameter is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for the content of a tight list. A tight list item shows its paragraph without a ","type":"text"},{"code":"<p>","type":"codeVoice"},{"text":" element.","type":"text"}],"type":"paragraph"},{"anchor":"Change-how-an-inline-element-is-generated","level":3,"text":"Change how an inline element is generated","type":"heading"},{"inlineContent":[{"text":"Override ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(textFragment:)","isActive":true,"type":"reference"},{"text":" to change the HTML of emphasis, links and other inline fragments. This generator opens links in a new tab:","type":"text"}],"type":"paragraph"},{"code":["final class NewTabHtmlGenerator: HtmlGenerator, @unchecked Sendable {","  override func generate(textFragment fragment: TextFragment) -> String {","    if case .link(let text, let uri, let title) = fragment {","      return \"<a href=\\\"\\(self.hrefAttribute(uri ?? \"\"))\\\"\\(self.titleAttribute(title))\" +","             \" target=\\\"_blank\\\" rel=\\\"noopener\\\">\\(self.generate(text: text))</a>\"","    }","    return super.generate(textFragment: fragment)","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/hrefAttribute(_:decode:image:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/titleAttribute(_:)","isActive":true,"type":"reference"},{"text":" for URLs and titles. They escape the values so that they cannot break out of the attribute, and in safe mode they empty URLs with unsafe schemes. A subclass that writes these attributes itself has to do the same; see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/RenderingUntrustedMarkdown","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Generate-HTML-for-custom-elements","level":3,"text":"Generate HTML for custom elements","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomBlock","isActive":true,"type":"reference"},{"text":" and a ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomTextFragment","isActive":true,"type":"reference"},{"text":" create their own HTML, see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser","isActive":true,"type":"reference"},{"text":". The generator calls ","type":"text"},{"code":"generateHtml(via:tight:)","type":"codeVoice"},{"text":" of a custom block and ","type":"text"},{"code":"generateHtml(via:)","type":"codeVoice"},{"text":" of a custom text fragment and passes itself, so a custom element can use the generator’s methods for its content, e.g. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(text:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Know-the-thread-safety-rules","level":3,"text":"Know the thread-safety rules","type":"heading"},{"inlineContent":[{"text":"A generator is shared between threads like the other classes, so a subclass restates ","type":"text"},{"code":"@unchecked Sendable","type":"codeVoice"},{"text":" as above and must not keep mutable state, unless it synchronizes it. See ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator":{"abstract":[{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into","type":"text"},{"text":" ","type":"text"},{"code":"NSAttributedString","type":"codeVoice"},{"text":" objects that are used in macOS and iOS for displaying rich text.","type":"text"},{"text":" ","type":"text"},{"text":"The implementation is extensible allowing subclasses of ","type":"text"},{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"override how individual Markdown structures are converted into attributed strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AttributedStringGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AttributedStringGenerator"}],"role":"symbol","title":"AttributedStringGenerator","type":"topic","url":"/documentation/markdownkit/attributedstringgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/CustomBlock":{"abstract":[{"text":"Protocol ","type":"text"},{"code":"CustomBlock","type":"codeVoice"},{"text":" defines the interface of custom Markdown elements that are implemented","type":"text"},{"text":" ","type":"text"},{"text":"externally (i.e. not by the MarkdownKit framework).","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomBlock"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomBlock","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CustomBlock"}],"role":"symbol","title":"CustomBlock","type":"topic","url":"/documentation/markdownkit/customblock"},"doc://MarkdownKit/documentation/MarkdownKit/CustomTextFragment":{"abstract":[{"text":"Protocol ","type":"text"},{"code":"CustomTextFragment","type":"codeVoice"},{"text":" defines the interface for custom Markdown text fragments","type":"text"},{"text":" ","type":"text"},{"text":"that are implemented externally (i.e. not by the MarkdownKit framework).","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"CustomTextFragment"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomTextFragment","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CustomTextFragment"}],"role":"symbol","title":"CustomTextFragment","type":"topic","url":"/documentation/markdownkit/customtextfragment"},"doc://MarkdownKit/documentation/MarkdownKit/CustomizingAttributedStringOutput":{"abstract":[{"text":"Style the attributed strings that ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":" creates, and understand what the system’s HTML importer does with the styles.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomizingAttributedStringOutput","kind":"article","role":"article","title":"Customizing Attributed String Output","type":"topic","url":"/documentation/markdownkit/customizingattributedstringoutput"},"doc://MarkdownKit/documentation/MarkdownKit/CustomizingHTMLOutput":{"abstract":[{"text":"Change the HTML that MarkdownKit generates by subclassing ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomizingHTMLOutput","kind":"article","role":"article","title":"Customizing HTML Output","type":"topic","url":"/documentation/markdownkit/customizinghtmloutput"},"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser":{"abstract":[{"text":"Add your own inline markup to the Markdown syntax that MarkdownKit supports.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser","kind":"article","role":"article","title":"Extending the Parser","type":"topic","url":"/documentation/markdownkit/extendingtheparser"},"doc://MarkdownKit/documentation/MarkdownKit/GeneratingOutput":{"abstract":[{"text":"Convert a parsed Markdown document into HTML, attributed strings, plain text or text for ANSI terminals.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/GeneratingOutput","kind":"article","role":"article","title":"Generating Output","type":"topic","url":"/documentation/markdownkit/generatingoutput"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator":{"abstract":[{"code":"HtmlGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into HTML. The","type":"text"},{"text":" ","type":"text"},{"text":"implementation is extensible allowing subclasses of ","type":"text"},{"code":"HtmlGenerator","type":"codeVoice"},{"text":" to override how","type":"text"},{"text":" ","type":"text"},{"text":"individual Markdown structures are converted into HTML.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"HtmlGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HtmlGenerator"}],"role":"symbol","title":"HtmlGenerator","type":"topic","url":"/documentation/markdownkit/htmlgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/Parent":{"abstract":[{"text":"The chain of blocks that enclose the block which is being generated. It lets a subclass","type":"text"},{"text":" ","type":"text"},{"text":"find out in which context a block appears, e.g. in a block quote or in a list item.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Parent"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/Parent","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Parent"}],"role":"symbol","title":"HtmlGenerator.Parent","type":"topic","url":"/documentation/markdownkit/htmlgenerator/parent"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(block:parent:tight:)":{"abstract":[{"text":"Generates the HTML for one block which has the enclosing blocks ","type":"text"},{"code":"parent","type":"codeVoice"},{"text":". ","type":"text"},{"code":"tight","type":"codeVoice"},{"text":" is true","type":"text"},{"text":" ","type":"text"},{"text":"if the block is part of a tight list. This is the method to override for changing how a","type":"text"},{"text":" ","type":"text"},{"text":"kind of block is converted into HTML; call ","type":"text"},{"code":"super","type":"codeVoice"},{"text":" for all other blocks, as in the","type":"text"},{"text":" ","type":"text"},{"text":"example of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomizingHTMLOutput","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"generate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"block"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit5BlockO","text":"Block"},{"kind":"text","text":", "},{"kind":"externalParam","text":"parent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit13HtmlGeneratorC6ParentO","text":"Parent"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tight"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(block:parent:tight:)","kind":"symbol","role":"symbol","title":"generate(block:parent:tight:)","type":"topic","url":"/documentation/markdownkit/htmlgenerator/generate(block:parent:tight:)"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(blocks:parent:tight:)":{"abstract":[{"text":"Generates the HTML for a sequence of blocks which have the enclosing blocks ","type":"text"},{"code":"parent","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"tight","type":"codeVoice"},{"text":" is true if the blocks are the content of a tight list, in which paragraphs are","type":"text"},{"text":" ","type":"text"},{"text":"not wrapped into ","type":"text"},{"code":"<p>","type":"codeVoice"},{"text":" elements. The HTML of the blocks is concatenated.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"generate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"blocks"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit6Blocksa","text":"Blocks"},{"kind":"text","text":", "},{"kind":"externalParam","text":"parent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit13HtmlGeneratorC6ParentO","text":"Parent"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tight"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(blocks:parent:tight:)","kind":"symbol","role":"symbol","title":"generate(blocks:parent:tight:)","type":"topic","url":"/documentation/markdownkit/htmlgenerator/generate(blocks:parent:tight:)"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(doc:)":{"abstract":[{"code":"generate","type":"codeVoice"},{"text":" takes a block representing a Markdown document and returns a corresponding","type":"text"},{"text":" ","type":"text"},{"text":"representation in HTML as a string.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"generate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"doc"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit5BlockO","text":"Block"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(doc:)","kind":"symbol","role":"symbol","title":"generate(doc:)","type":"topic","url":"/documentation/markdownkit/htmlgenerator/generate(doc:)"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(text:)":{"abstract":[{"text":"Generates the HTML for inline text by concatenating the HTML of its fragments.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"generate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"text"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit4TextV","text":"Text"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(text:)","kind":"symbol","role":"symbol","title":"generate(text:)","type":"topic","url":"/documentation/markdownkit/htmlgenerator/generate(text:)"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(textFragment:)":{"abstract":[{"text":"Generates the HTML for one inline fragment, such as emphasized text or a link. Override","type":"text"},{"text":" ","type":"text"},{"text":"this method to change the HTML for a kind of fragment.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"generate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"textFragment"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit12TextFragmentO","text":"TextFragment"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/generate(textFragment:)","kind":"symbol","role":"symbol","title":"generate(textFragment:)","type":"topic","url":"/documentation/markdownkit/htmlgenerator/generate(textfragment:)"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/hrefAttribute(_:decode:image:)":{"abstract":[{"text":"Returns the escaped value for the ","type":"text"},{"code":"href","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"src","type":"codeVoice"},{"text":" attribute for the given URL. In safe mode,","type":"text"},{"text":" ","type":"text"},{"text":"URLs with unsafe schemes are replaced with the empty string. If ","type":"text"},{"code":"decode","type":"codeVoice"},{"text":" is true, entities","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"url","type":"codeVoice"},{"text":" get decoded first.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hrefAttribute"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"decode"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"image"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/hrefAttribute(_:decode:image:)","kind":"symbol","role":"symbol","title":"hrefAttribute(_:decode:image:)","type":"topic","url":"/documentation/markdownkit/htmlgenerator/hrefattribute(_:decode:image:)"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/init(safeMode:)":{"abstract":[{"text":"Creates an HTML generator. If ","type":"text"},{"code":"safeMode","type":"codeVoice"},{"text":" is true, raw HTML is omitted and URLs with unsafe","type":"text"},{"text":" ","type":"text"},{"text":"schemes are emptied; see ","type":"text"},{"code":"safeMode","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"safeMode"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/init(safeMode:)","kind":"symbol","role":"symbol","title":"init(safeMode:)","type":"topic","url":"/documentation/markdownkit/htmlgenerator/init(safemode:)"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/titleAttribute(_:)":{"abstract":[{"text":"Returns the title attribute (including a leading space) or the empty string.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"titleAttribute"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/titleAttribute(_:)","kind":"symbol","role":"symbol","title":"titleAttribute(_:)","type":"topic","url":"/documentation/markdownkit/htmlgenerator/titleattribute(_:)"},"doc://MarkdownKit/documentation/MarkdownKit/RenderingUntrustedMarkdown":{"abstract":[{"text":"Restrict what raw HTML, links and images in a document may do when the Markdown does not come from you.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/RenderingUntrustedMarkdown","kind":"article","role":"article","title":"Rendering Untrusted Markdown","type":"topic","url":"/documentation/markdownkit/renderinguntrustedmarkdown"},"doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently":{"abstract":[{"text":"Parse and generate on background threads and tasks, and know what to restate in subclasses.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently","kind":"article","role":"article","title":"Using MarkdownKit Concurrently","type":"topic","url":"/documentation/markdownkit/usingmarkdownkitconcurrently"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc://MarkdownKit/documentation/MarkdownKit/GeneratingOutput","doc://MarkdownKit/documentation/MarkdownKit/CustomizingAttributedStringOutput"],"title":"Related Documentation"},{"anchor":"Generating-HTML","generated":true,"identifiers":["doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator"],"title":"Generating HTML"}],"variants":[{"paths":["/documentation/markdownkit/customizinghtmloutput"],"traits":[{"interfaceLanguage":"swift"}]}]}