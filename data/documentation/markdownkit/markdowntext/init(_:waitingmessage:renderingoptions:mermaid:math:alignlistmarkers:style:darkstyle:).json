alse, "},{"kind":"externalParam","text":"style"},{"kind":"text","text":": "},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit25AttributedStringGeneratorC","text":"AttributedStringGenerator"},{"kind":"text","text":"."},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/Style-swift.struct","kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit25AttributedStringGeneratorC5StyleV","text":"Style"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"darkStyle"},{"kind":"text","text":": "},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit25AttributedStringGeneratorC","text":"AttributedStringGenerator"},{"kind":"text","text":"."},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/Style-swift.struct","kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit25AttributedStringGeneratorC5StyleV","text":"Style"},{"kind":"text","text":"? = nil)"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The Markdown document.","type":"text"}],"type":"paragraph"}],"name":"text"},{"content":[{"inlineContent":[{"text":"What is displayed until the document has been converted.","type":"text"}],"type":"paragraph"}],"name":"waitingMessage"},{"content":[{"inlineContent":[{"text":"The options for rendering the generated HTML.","type":"text"}],"type":"paragraph"}],"name":"renderingOptions"},{"content":[{"inlineContent":[{"text":"The configuration for drawing Mermaid diagrams, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (the default) to","type":"text"},{"text":" ","type":"text"},{"text":"show them as code like any other code block.","type":"text"}],"type":"paragraph"}],"name":"mermaid"},{"content":[{"inlineContent":[{"text":"The configuration for showing formulas, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (the default) to show the","type":"text"},{"text":" ","type":"text"},{"text":"LaTeX as code.","type":"text"}],"type":"paragraph"}],"name":"math"},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (the default is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":"), the view puts the number or bullet","type":"text"},{"text":" ","type":"text"},{"text":"of a list item on the baseline of the first line of its item, also","type":"text"},{"text":" ","type":"text"},{"text":"if an image (such as a formula) makes that line taller than the text.","type":"text"},{"text":" ","type":"text"},{"text":"The system lays out the cells of the table that a list is at their","type":"text"},{"text":" ","type":"text"},{"text":"top, so the marker is above the text otherwise. This is only","type":"text"},{"text":" ","type":"text"},{"text":"noticeable for images in the first line of an item. The view measures","type":"text"},{"text":" ","type":"text"},{"text":"its layout after each layout (also when its size changes) for this","type":"text"},{"text":" ","type":"text"},{"text":"and needs the text system of TextKit 1 for lists on iOS, which","type":"text"},{"text":" ","type":"text"},{"text":"costs time for long texts; this is why it is optional. It is","type":"text"},{"text":" ","type":"text"},{"text":"available on macOS and iOS.","type":"text"}],"type":"paragraph"}],"name":"alignListMarkers"},{"content":[{"inlineContent":[{"text":"The appearance of the text in light mode: fonts, colors, spacing and CSS. If ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(the default), it is ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/Style-swift.struct/default","isActive":true,"type":"reference"},{"text":", which uses the","type":"text"},{"text":" ","type":"text"},{"text":"colors of the system.","type":"text"}],"type":"paragraph"}],"name":"style"},{"content":[{"inlineContent":[{"text":"The appearance of the text in dark mode. If ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" (the default), it is","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/Style-swift.struct/dark","isActive":true,"type":"reference"},{"text":": light text on a dark background.","type":"text"}],"type":"paragraph"}],"name":"darkStyle"}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The attributed string is generated synchronously (see","type":"text"},{"text":" ","type":"text"},{"code":"AttributedStringGenerator.generate(doc:)","type":"codeVoice"},{"text":"). Therefore, only the rendering options","type":"text"},{"text":" ","type":"text"},{"code":"baseUrl","type":"codeVoice"},{"text":", ","type":"text"},{"code":"localImages","type":"codeVoice"},{"text":", ","type":"text"},{"code":"imageExtensions","type":"codeVoice"},{"text":", ","type":"text"},{"code":"safeMode","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"textSizeMultiplier","type":"codeVoice"},{"text":" have an","type":"text"},{"text":" ","type":"text"},{"text":"effect; remote images are never loaded. Use ","type":"text"},{"code":"RenderingOptions.untrusted","type":"codeVoice"},{"text":" if the","type":"text"},{"text":" ","type":"text"},{"text":"Markdown does not come from a trusted source.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If ","type":"text"},{"code":"mermaid","type":"codeVoice"},{"text":" is not ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", fenced code blocks with language ","type":"text"},{"code":"mermaid","type":"codeVoice"},{"text":" are shown as","type":"text"},{"text":" ","type":"text"},{"text":"diagrams. They are rendered in the background: the view first shows the diagram as code","type":"text"},{"text":" ","type":"text"},{"text":"and replaces it with the diagram once it has been rendered. In dark mode,","type":"text"},{"text":" ","type":"text"},{"code":"MermaidConfig.darkVariant","type":"codeVoice"},{"text":" is used. Diagrams are only supported on macOS and iOS.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If ","type":"text"},{"code":"math","type":"codeVoice"},{"text":" is not ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", the formulas of the document (which a parser such as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathMarkdownParser","isActive":true,"type":"reference"},{"text":" recognizes) are shown as images, in the colour of the text around","type":"text"},{"text":" ","type":"text"},{"text":"them (see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathAttributedStringGenerator","isActive":true,"type":"reference"},{"text":"). Like diagrams, they are drawn in the","type":"text"},{"text":" ","type":"text"},{"text":"background: the view first shows the LaTeX of a formula as code and replaces it with the","type":"text"},{"text":" ","type":"text"},{"text":"formula once it has been rendered. Formulas are only supported on macOS and iOS.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator":{"abstract":[{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into","type":"text"},{"text":" ","type":"text"},{"code":"NSAttributedString","type":"codeVoice"},{"text":" objects that are used in macOS and iOS for displaying rich text.","type":"text"},{"text":" ","type":"text"},{"text":"The implementation is extensible allowing subclasses of ","type":"text"},{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"override how individual Markdown structures are converted into attributed strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AttributedStringGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AttributedStringGenerator"}],"role":"symbol","title":"AttributedStringGenerator","type":"topic","url":"/documentation/markdownkit/attributedstringgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/RenderingOptions-swift.struct":{"abstract":[{"text":"Options for rendering the HTML that ","type":"text"},{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" generates into an","type":"text"},{"text":" ","type":"text"},{"code":"NSAttributedString","type":"codeVoice"},{"text":". They are used by the synchronous methods (","type":"text"},{"code":"generate(doc:)","type":"codeVoice"},{"text":" etc.) as","type":"text"},{"text":" ","type":"text"},{"text":"well as by the asynchronous ones (","type":"text"},{"code":"generateAsync(doc:)","type":"codeVoice"},{"text":" etc.).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderingOptions"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/RenderingOptions-swift.struct","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RenderingOptions"}],"role":"symbol","title":"AttributedStringGenerator.RenderingOptions","type":"topic","url":"/documentation/markdownkit/attributedstringgenerator/renderingoptions-swift.struct