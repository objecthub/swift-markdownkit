t":" ","type":"text"},{"text":"at a time, and is released when it has not been used for a while. The images (black on a","type":"text"},{"text":" ","type":"text"},{"text":"transparent background; the colour is applied when a formula is shown) are cached.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MathRenderer"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathRenderer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MathRenderer"}],"role":"symbol","title":"MathRenderer","type":"topic","url":"/documentation/markdownkit/mathrenderer"},"doc://MarkdownKit/documentation/MarkdownKit/MathRenderer/render(_:display:fontSize:config:)":{"abstract":[{"text":"Renders a formula and returns its image. If the formula has been rendered before, the","type":"text"},{"text":" ","type":"text"},{"text":"cached image is returned at once. To render many formulas, use ","type":"text"},{"code":"render(_:fontSize:config:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which draws them together. Code which does not use Swift concurrency can use","type":"text"},{"text":" ","type":"text"},{"code":"render(_:display:fontSize:config:completionHandler:)","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"render"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"display"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fontSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sf","text":"Float"},{"kind":"text","text":", "},{"kind":"externalParam","text":"config"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseI