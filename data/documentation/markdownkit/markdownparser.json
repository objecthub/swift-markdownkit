{"abstract":[{"code":"MarkdownParser","type":"codeVoice"},{"text":" objects are used to parse Markdown text represented as a string.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"MarkdownParser","type":"codeVoice"},{"text":" object itself defines the configuration of the parser. It is","type":"text"},{"text":" ","type":"text"},{"text":"stateless in the sense that it can be used for parsing many input strings. This is","type":"text"},{"text":" ","type":"text"},{"text":"done via the ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" function. ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" returns an abstract syntax tree representing","type":"text"},{"text":" ","type":"text"},{"text":"the Markdown text for the given input string.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser"},"kind":"symbol","metadata":{"externalID":"s:11MarkdownKit0A6ParserC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MarkdownParser"}],"modules":[{"name":"MarkdownKit"}],"navigatorTitle":[{"kind":"identifier","text":"MarkdownParser"}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"MarkdownParser"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MarkdownParser"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc://MarkdownKit/documentation/MarkdownKit/ConfiguringTheParser","doc://MarkdownKit/documentation/MarkdownKit/ChoosingAParser","doc://MarkdownKit/documentation/MarkdownKit/GettingStarted","doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently"]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" method of the ","type":"text"},{"code":"MarkdownParser","type":"codeVoice"},{"text":" object delegates parsing of the input","type":"text"},{"text":" ","type":"text"},{"text":"string to two types of processors: a ","type":"text"},{"code":"BlockParser","type":"codeVoice"},{"text":" object and an ","type":"text"},{"code":"InlineTransformer","type":"codeVoice"},{"text":" ","type":"text"},{"text":"object. A ","type":"text"},{"code":"BlockParser","type":"codeVoice"},{"text":" parses the Markdown block structure returning an abstract","type":"text"},{"text":" ","type":"text"},{"text":"syntax tree ignoring inline markup. An ","type":"text"},{"code":"InlineTransformer","type":"codeVoice"},{"text":" object is used to parse","type":"text"},{"text":" ","type":"text"},{"text":"a particular type of inline markup within text of Markdown blocks, replacing the","type":"text"},{"text":" ","type":"text"},{"text":"matching text with an abstract syntax tree representing the markup.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" method of ","type":"text"},{"code":"MarkdownParser","type":"codeVoice"},{"text":" operates in two phases: in the first phase,","type":"text"},{"text":" ","type":"text"},{"text":"the block structure of an input string is identified via the ","type":"text"},{"code":"BlockParser","type":"codeVoice"},{"text":"s. In the","type":"text"},{"text":" ","type":"text"},{"text":"second phase, the block structure gets traversed and markup within raw text gets","type":"text"},{"text":" ","type":"text"},{"text":"replaced with a structured representation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Instances are immutable once they have been created and conform to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", so a","type":"text"},{"text":" ","type":"text"},{"text":"single instance (such as ","type":"text"},{"code":"MarkdownParser.standard","type":"codeVoice"},{"text":") can be used from several threads or tasks","type":"text"},{"text":" ","type":"text"},{"text":"at the same time. The conformance is ","type":"text"},{"code":"@unchecked","type":"codeVoice"},{"text":" because the class is ","type":"text"},{"code":"open","type":"codeVoice"},{"text":": a","type":"text"},{"text":" ","type":"text"},{"text":"subclass which adds mutable state has to synchronize it itself, and has to restate","type":"text"},{"text":" ","type":"text"},{"text":"the conformance as ","type":"text"},{"code":"@unchecked Sendable","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Every call of ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" creates new ","type":"text"},{"code":"DocumentParser","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"InlineParser","type":"codeVoice"},{"text":" objects, which are used","type":"text"},{"text":" ","type":"text"},{"text":"by the calling thread only.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/GettingStarted","isActive":true,"type":"reference"},{"text":" for an introduction, ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ChoosingAParser","isActive":true,"type":"reference"},{"text":" for the parser classes","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ConfiguringTheParser","isActive":true,"type":"reference"},{"text":" for how to configure a parser.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","ty