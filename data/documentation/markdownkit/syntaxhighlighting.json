bjc(cs)NSAttributedString","text":"NSAttributedString"},{"kind":"text","text":"?"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/asAttributedString(_:using:fastRender:lineNumbering:)","kind":"symbol","role":"symbol","title":"asAttributedString(_:using:fastRender:lineNumbering:)","type":"topic","url":"/documentation/markdownkit/syntaxhighlighter/asattributedstring(_:using:fastrender:linenumbering:)"},"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/availableThemes":{"abstract":[{"text":"An array of available theme names.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"availableThemes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/availableThemes","kind":"symbol","role":"symbol","title":"availableThemes","type":"topic","url":"/documentation/markdownkit/syntaxhighlighter/availablethemes"},"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/getAnsiConfig(forTheme:fullColorSupport:)":{"abstract":[{"text":"Loads an ANSI highlighting configuration for terminal output.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"getAnsiConfig"},{"kind":"text","text":"("},{"kind":"externalParam","text":"forTheme"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fullColorSupport"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit22AnsiHighlightingConfigV","text":"AnsiHighlightingConfig"},{"kind":"text","text":"?"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/getAnsiConfig(forTheme:fullColorSupport:)","kind":"symbol","role":"symbol","title":"getAnsiConfig(forTheme:fullColorSupport:)","type":"topic","url":"/documentation/markdownkit/syntaxhighlighter/getansiconfig(fortheme:fullcolorsupport:)"},"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/highlight(code:as:ignoreIllegals:)":{"abstract":[{"text":"Applies syntax highlighting to source code.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"highlight"},{"kind":"text","text":"("},{"kind":"externalParam","text":"code"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"as"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"ignoreIllegals"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/highlight(code:as:ignoreIllegals:)","kind":"symbol","role":"symbol","title":"highlight(code:as:ignoreIllegals:)","type":"topic","url":"/documentation/markdownkit/syntaxhighlighter/highlight(code:as:ignoreillegals:)"},"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/proxy":{"abstract":[{"text":"The shared singleton instance of ","type":"text"},{"code":"SyntaxHighlighter","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"proxy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit17SyntaxHighlighterC","text":"SyntaxHighlighter"},{"kind":"text","text":"?"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/proxy","kind":"symbol","role":"symbol","title":"proxy","type":"topic","url":"/documentation/markdownkit/syntaxhighlighter/proxy"},"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/supportedLanguages":{"abstract":[{"text":"An array of language identifiers supported by Highlight.js.","type":"text"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"supportedLanguages"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/supportedLanguages","kind":"symbol","role":"symbol","title":"supportedLanguages","type":"topic","url":"/documentation/markdownkit/syntaxhighlighter/supportedlanguages"},"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator":{"abstract":[{"code":"TerminalGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into text for","type":"text"},{"text":" ","type":"text"},{"text":"ANSI-compliant terminals, with word wrapping, indentation, and styled text. The result is","type":"text"},{"text":" ","type":"text"},{"text":"marked up with ANSI escape sequences. The implementation is extensible allowing subclasses","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"TerminalGenerator","type":"codeVoice"},{"text":" to override how individual Markdown structures are converted into","type":"text"},{"text":" ","type":"text"},{"text":"styled text.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TerminalGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TerminalGenerator"}],"role":"symbol","title":"TerminalGenerator","type":"topic","url":"/documentation/markdownkit/terminalgenerator"},"https://github.com/highlightjs/highlight.js/":{"identifier":"https://github.com/highlightjs/highlight.js/","title":"Highlight.js","titleInlineContent":[{"text":"Highlight.js","type":"text"}],"type":"link","url":"https://github.com/highlightjs/highlight.js/"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc://MarkdownKit/documentation/MarkdownKit/GeneratingOutput"],"title":"Related Documentation"},{"anchor":"Highlighting-code","generated":true,"identifiers":["doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter","doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig","doc://MarkdownKit/documentation/MarkdownKit/AnsiHighlightingConfig"],"title":"Highlighting code"}],"variants":[{"paths":["/documentation/markdownkit/syntaxhighlighting"],"traits":[{"interfaceLanguage":"swift"}]}]}