{"abstract":[{"text":"Color the code of fenced code blocks in attributed strings and terminal output, or highlight code on its own.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighting"},"kind":"article","metadata":{"modules":[{"name":"MarkdownKit"}],"role":"article","roleHeading":"Article","title":"Highlighting Code"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"MarkdownKit uses ","type":"text"},{"identifier":"https://github.com/highlightjs/highlight.js/","isActive":true,"type":"reference"},{"text":" to find the keywords, strings, comments and other elements of the source code in fenced code blocks. Highlight.js runs in JavaScriptCore, which is why syntax highlighting is not available on watchOS. The generators style the result with a ","type":"text"},{"inlineContent":[{"text":"theme","type":"text"}],"type":"emphasis"},{"text":", which is a CSS style sheet with rules for the classes that Highlight.js assigns, such as ","type":"text"},{"code":".hljs-keyword","type":"codeVoice"},{"text":". The framework ships with over 100 themes, and you can pass your own CSS.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator","isActive":true,"type":"reference"},{"text":" highlight by default. The attributed string generator highlights code only with its default ","type":"text"},{"code":"version: .OS26","type":"codeVoice"},{"text":". The older ","type":"text"},{"code":".preOS26","type":"codeVoice"},{"text":" generator shows code blocks without colors, so that the output of existing code does not change. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":" does not highlight: it marks the code block with the language as a ","type":"text"},{"code":"class","type":"codeVoice"},{"text":" (","type":"text"},{"code":"<pre><code class=\"language-swift\">","type":"codeVoice"},{"text":"), so a web page can load Highlight.js itself.","type":"text"}],"type":"paragraph"},{"anchor":"Configure-highlighting-in-generators","level":3,"text":"Configure highlighting in generators","type":"heading"},{"inlineContent":[{"text":"Both generators take a ","type":"text"},{"code":"syntaxHighlighting:","type":"codeVoice"},{"text":" parameter with a ","type":"text"},{"code":"SyntaxHighlightingConfig","type":"codeVoice"},{"text":" value. Setting this parameter to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" disables syntax highlighting.","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Property","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Meaning","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"theme","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"either the name of a bundled theme (e.g. ","type":"text"},{"code":"\"github\"","type":"codeVoice"},{"text":") or CSS to be used with Highlight.js","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"ignoreSyntacticIssues","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"highlight the code even if Highlight.js finds a syntax error","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"ignoredLanguages","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"languages that are not highlighted; the empty string stands for fenced code blocks without a language","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"highlightIndentedCodeBlocks","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"whether Highlight.js infers the language of indented code blocks","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"The default configurations are ","type":"text"},{"code":".default","type":"codeVoice"},{"text":", which has a light theme, and ","type":"text"},{"code":".defaultDark","type":"codeVoice"},{"text":". The default ignores fenced code blocks without a language, so no language is guessed for them. The language of a fenced code block is the first word of its info string:","type":"text"}],"type":"paragraph"},{"code":["```swift","let x = 42","```"],"syntax":"markdown","type":"codeListing"},{"inlineContent":[{"text":"The terminal generator’s configuration has one more property, ","type":"text"},{"code":"fullColorSupport","type":"codeVoice"},{"text":", which selects the 256-color palette. Its default is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let generator = AttributedStringGenerator(","  syntaxHighlighting: AttributedStringGenerator.SyntaxHighlightingConfig(","                        theme: \"monokai\", ignoredLanguages: [\"text\"]))","let terminal = TerminalGenerator(","  syntaxHighlighting: TerminalGenerator.SyntaxHighlightingConfig(","                        theme: \"github\", fullColorSupport: false))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For attributed strings in dark mode, use ","type":"text"},{"code":".defaultDark","type":"codeVoice"},{"text":" or a dark theme, as in the example of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/DisplayingMarkdownWithSwiftUI","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Use-a-custom-highlighter","level":3,"text":"Use a custom highlighter","type":"heading"},{"inlineContent":[{"text":"The generators use the shared highlighter ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/proxy","isActive":true,"type":"reference"},{"text":", which is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if its resources are missing. To use another version of Highlight.js or your own themes, create a ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter","isActive":true,"type":"reference"},{"text":" with the location of the JavaScript file and a directory of theme files (each ","type":"text"},{"code":".css","type":"codeVoice"},{"text":" file in it is a theme), and pass it as ","type":"text"},{"code":"syntaxHighlighter:","type":"codeVoice"},{"text":" to the generator:","type":"text"}],"type":"paragraph"},{"code":["let highlighter = SyntaxHighlighter(highlightJSURL: URL(fileURLWithPath: \"/path/to/highlight.min.js\"),","                                    themeDirectory: URL(fileURLWithPath: \"/path/to/themes\"))","let generator = AttributedStringGenerator(syntaxHighlighter: highlighter)"],"syntax":"swift","type":"codeListing"},{"anchor":"Write-themes","level":3,"text":"Write themes","type":"heading"},{"inlineContent":[{"text":"A theme is CSS with rules for the classes that Highlight.js assigns to the parts of highlighted code, for example ","type":"text"},{"code":".hljs-keyword{color:#f00;font-weight:bold}","type":"codeVoice"},{"text":". The selectors consist of classes: ","type":"text"},{"code":".a","type":"codeVoice"},{"text":", ","type":"text"},{"code":".a.b","type":"codeVoice"},{"text":", descendant selectors (","type":"text"},{"code":".a .b","type":"codeVoice"},{"text":") and child selectors (","type":"text"},{"code":".a > .b","type":"codeVoice"},{"text":"). The cascade follows CSS: a rule with a higher specificity (more classes) wins over one with a lower specificity, otherwise the last rule wins. The properties ","type":"text"},{"code":"color","type":"codeVoice"},{"text":", ","type":"text"},{"code":"background-color","type":"codeVoice"},{"text":", ","type":"text"},{"code":"font-weight","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"font-style","type":"codeVoice"},{"text":" are used for attributed strings; terminal output also uses ","type":"text"},{"code":"text-decoration","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/availableThemes","isActive":true,"type":"reference"},{"text":" lists the names of the themes in the highlighter’s theme directory, and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/supportedLanguages","isActive":true,"type":"reference"},{"text":" the languages that Highlight.js knows.","type":"text"}],"type":"paragraph"},{"anchor":"Highlight-code-on-its-own","level":3,"text":"Highlight code on its own","type":"heading"},{"inlineContent":[{"text":"You can also highlight code without a generator: ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/highlight(code:as:ignoreIllegals:)","isActive":true,"type":"reference"},{"text":" returns HTML, and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/asAttributedString(_:using:fastRender:lineNumbering:)","isActive":true,"type":"reference"},{"text":" turns it into an attributed string for a ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["guard let highlighter = SyntaxHighlighter.proxy else { return }","let config = highlighter.getConfig(forTheme: \"github\", withFont: \"Monaco\", ofSize: 14.0)","if let highlighted = highlighter.highlight(code: \"let x = 42\", as: \"swift\"),","   let config {","  let attributed = highlighter.asAttributedString(highlighted, using: config)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Pass a ","type":"text"},{"code":"SyntaxHighlighter.LineNumberConfig","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"lineNumbering:","type":"codeVoice"},{"text":" to add line numbers. For terminals, ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/getAnsiConfig(forTheme:fullColorSupport:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/asAnsiTerminalString(_:using:)","isActive":true,"type":"reference"},{"text":" do the same with ANSI escape codes.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/AnsiHighlightingConfig":{"abstract":[{"text":"Configuration for converting syntax-highlighted HTML to ANSI terminal strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnsiHighlightingConfig"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AnsiHighlightingConfig","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AnsiHighlightingConfig"}],"role":"symbol","title":"AnsiHighlightingConfig","type":"topic","url":"/documentation/markdownkit/ansihighlightingconfig"},"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator":{"abstract":[{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into","type":"text"},{"text":" ","type":"text"},{"code":"NSAttributedString","type":"codeVoice"},{"text":" objects that are used in macOS and iOS for displaying rich text.","type":"text"},{"text":" ","type":"text"},{"text":"The implementation is extensible allowing subclasses of ","type":"text"},{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"override how individual Markdown structures are converted into attributed strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AttributedStringGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AttributedStringGenerator"}],"role":"symbol","title":"AttributedStringGenerator","type":"topic","url":"/documentation/markdownkit/attributedstringgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/DisplayingMarkdownWithSwiftUI":{"abstract":[{"text":"Show a Markdown document in a SwiftUI view, and adapt it to light and dark mode.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/DisplayingMarkdownWithSwiftUI","kind":"article","role":"article","title":"Displaying Markdown with SwiftUI","type":"topic","url":"/documentation/markdownkit/displayingmarkdownwithswiftui"},"doc://MarkdownKit/documentation/MarkdownKit/GeneratingOutput":{"abstract":[{"text":"Convert a parsed Markdown document into HTML, attributed strings, plain text or text for ANSI terminals.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/GeneratingOutput","kind":"article","role":"article","title":"Generating Output","type":"topic","url":"/documentation/markdownkit/generatingoutput"},"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig":{"abstract":[{"text":"Theme objects used for generating attributed strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HighlightingConfig"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HighlightingConfig"}],"role":"symbol","title":"HighlightingConfig","type":"topic","url":"/documentation/markdownkit/highlightingconfig"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator":{"abstract":[{"code":"HtmlGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into HTML. The","type":"text"},{"text":" ","type":"text"},{"text":"implementation is extensible allowing subclasses of ","type":"text"},{"code":"HtmlGenerator","type":"codeVoice"},{"text":" to override how","type":"text"},{"text":" ","type":"text"},{"text":"individual Markdown structures are converted into HTML.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"HtmlGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HtmlGenerator"}],"role":"symbol","title":"HtmlGenerator","type":"topic","url":"/documentation/markdownkit/htmlgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter":{"abstract":[{"text":"A syntax highlighter that uses Highlight.js to provide code syntax highlighting","type":"text"},{"text":" ","type":"text"},{"text":"with theme support and customizable rendering options.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SyntaxHighlighter"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SyntaxHighlighter"}],"role":"symbol","title":"SyntaxHighlighter","type":"topic","url":"/documentation/markdownkit/syntaxhighlighter"},"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/asAnsiTerminalString(_:using:)":{"abstract":[{"text":"Converts highlighted HTML into a styled ANSI terminal string.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"asAnsiT