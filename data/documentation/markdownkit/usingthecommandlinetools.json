lementation is","type":"text"},{"text":" ","type":"text"},{"text":"extensible allowing subclasses of ","type":"text"},{"code":"StringGenerator","type":"codeVoice"},{"text":" to override how individual Markdown","type":"text"},{"text":" ","type":"text"},{"text":"structures are converted into strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"StringGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/StringGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"StringGenerator"}],"role":"symbol","title":"StringGenerator","type":"topic","url":"/documentation/markdownkit/stringgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator":{"abstract":[{"code":"TerminalGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into text for","type":"text"},{"text":" ","type":"text"},{"text":"ANSI-compliant terminals, with word wrapping, indentation, and styled text. The result is","type":"text"},{"text":" ","type":"text"},{"text":"marked up with ANSI escape sequences. The implementation is extensible allowing subclasses","type":"text"},{"text":" ","type":"text"},{"text":"of ","type":"text"},{"code":"TerminalGenerator","type":"codeVoice"},{"text":" to override how individual Markdown structures are converted into","type":"text"},{"text":" ","type":"text"},{"text":"styled text.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TerminalGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TerminalGenerator"}],"role":"symbol","title":"TerminalGenerator","type":"topic","url":"/documentation/markdownkit/terminalgenerator"},"https://github.com/objecthub/swift-markdownkit/blob/master/Examples/Demo.md":{"identifier":"https://github.com/objecthub/swift-ma