{"abstract":[{"text":"Write a syntax tree back as Markdown, after you changed it or to normalize a document.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/GeneratingMarkdownSource"},"kind":"article","metadata":{"modules":[{"name":"MarkdownKit"}],"role":"article","roleHeading":"Article","title":"Generating Markdown Source"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator","isActive":true,"type":"reference"},{"text":" is the counterpart of the parser: for a syntax tree, it writes Markdown source which the parser reads back into the same tree. Use it to save a document after you changed its tree with code (see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ProcessingMarkdown","isActive":true,"type":"reference"},{"text":"), to normalize the formatting of Markdown files, or to create Markdown from a tree that you built yourself.","type":"text"}],"type":"paragraph"},{"code":["let dialect = MarkdownDialect.full","let doc = dialect.parser.parse(text)","let source = dialect.sourceGenerator.generate(doc: doc)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Use the dialect of the parser that read the text. A dialect determines which Markdown the generator may use and which characters it has to escape: the source of a document with a table only reads back as a table if the parser understands tables.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The generator does not reproduce the original text, it writes one form for every construct. Headings are written with ","type":"text"},{"code":"#","type":"codeVoice"},{"text":", emphasis with ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"**","type":"codeVoice"},{"text":", links in the inline form, tables without padding, and characters which could be taken for markup get a backslash (","type":"text"},{"code":"2 \\* 3","type":"codeVoice"},{"text":"). Bullets and numbers of lists, their density, code blocks, reference definitions and the line breaks of paragraphs stay as they are. Generating the source of the parsed result gives the same source again.","type":"text"}],"type":"paragraph"},{"anchor":"Check-that-the-source-reads-back","level":3,"text":"Check that the source reads back","type":"heading"},{"inlineContent":[{"text":"The result of parsing the generated source is the tree that you started with, but ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Text","isActive":true,"type":"reference"},{"text":" compare the fragments of text, which the parser splits at every character that may start markup, also if it is escaped: ","type":"text"},{"code":"a (b)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"a \\(b\\)","type":"codeVoice"},{"text":" are the same text but different fragments. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block/normalized","isActive":true,"type":"reference"},{"text":" (and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Text/normalized","isActive":true,"type":"reference"},{"text":") merges them, so compare normalized trees:","type":"text"}],"type":"paragraph"},{"code":["let generator = SourceGenerator(dialect: .full)","let again = MarkdownDialect.full.parser.parse(generator.generate(doc: doc))","again.normalized == doc.normalized     // true","again == doc                           // can be false: `2 \\* 3` has other fragments than `2 * 3`"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/roundTrips(_:)","isActive":true,"type":"reference"},{"text":" does this for you. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/firstMismatch(of:)","isActive":true,"type":"reference"},{"text":" describes the first difference, which is useful for error messages:","type":"text"}],"type":"paragraph"},{"code":["if let problem = generator.firstMismatch(of: doc) {","  print(\"cannot write the document: \\(problem)\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Choose-the-syntax","level":3,"text":"Choose the syntax","type":"heading"},{"inlineContent":[{"text":"A generator knows the syntax of a parser as a ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/Syntax-swift.struct","isActive":true,"type":"reference"},{"text":", a set of features. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/init(dialect:)","isActive":true,"type":"reference"},{"text":" takes the syntax of one of the standard parsers:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Dialect","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Syntax","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/commonMark","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"CommonMark","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/extendedCommonMark","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"additionally tables and definition lists","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/full","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"additionally underline, strikethrough and task lists","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/fullMath","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"additionally LaTeX math with dollar signs","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/fullLaTeX","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"additionally LaTeX math with the delimiters of LaTeX","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"The more the syntax has, the more characters have to be escaped: a generator for ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/fullMath","isActive":true,"type":"reference"},{"text":" writes ","type":"text"},{"code":"\\$5","type":"codeVoice"},{"text":", one for ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/commonMark","isActive":true,"type":"reference"},{"text":" writes ","type":"text"},{"code":"$5","type":"codeVoice"},{"text":". Escapes which a syntax needs are harmless for the parsers with a smaller syntax, so the source of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/standard","isActive":true,"type":"reference"},{"text":", which has the syntax of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/LaTeXMarkdownParser","isActive":true,"type":"reference"},{"text":", reads back correctly with every standard parser. Use it if you do not know the parser, and a generator for the dialect if you want the source with the fewest escapes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you configured the parser yourself (see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ConfiguringTheParser","isActive":true,"type":"reference"},{"text":") or extended it with new markup (see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser","isActive":true,"type":"reference"},{"text":"), create the generator with the features of the parser, the parser itself, and the characters which have a meaning for the parser:","type":"text"}],"type":"paragraph"},{"code":["let generator = SourceGenerator(syntax: .extendedCommonMark,","                                parser: MyMarkdownParser.standard,","                                specialCharacters: [\"~\"])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/roundTrips(_:)","isActive":true,"type":"reference"},{"text":" uses this parser for reading the source.","type":"text"}],"type":"paragraph"},{"anchor":"Know-what-cannot-be-written-back","level":3,"text":"Know what cannot be written back","type":"heading"},{"inlineContent":[{"text":"The generator never fails; it writes the best source it can. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/roundTrips(_:)","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" if the source reads back as a different tree:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The tree has elements that the syntax lacks. A generator for ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/commonMark","isActive":true,"type":"reference"},{"text":" writes the content of underlined text and a table as paragraphs, because it must not invent markup the parser does not read.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A custom block or text fragment has no source (see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser","isActive":true,"type":"reference"},{"text":"). It is written as plain text or as a code block.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The tree has a shape that no source expresses. The syntax tree of a text that the parser produces almost never has one. Examples are a link to an empty destination that comes from a reference definition (","type":"text"},{"code":"[foo]: <>","type":"codeVoice"},{"text":"), emphasis next to long runs of delimiter characters (","type":"text"},{"code":"foo******bar*********baz","type":"codeVoice"},{"text":"), and a formula within a line that spans several lines and starts a paragraph.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A tree that you changed by hand can have more shapes that the parser never produces: for instance a list whose density does not fit its items, a heading of level 3 with a line break, or text that starts with a space. Check it with ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/roundTrips(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Customize-the-output","level":3,"text":"Customize the output","type":"heading"},{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator","isActive":true,"type":"reference"},{"text":" is a recursive traversal of the syntax tree with one method for each level, like ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":". A subclass overrides the methods for the elements it wants to change and calls ","type":"text"},{"code":"super","type":"codeVoice"},{"text":" for the others:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Called for","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/generate(doc:)","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"the whole document","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/generate(blocks:parent:)","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"a sequence of blocks, with the blank lines between them","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/generate(block:parent:)","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"one block, as its lines","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/generate(text:in:)","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"inline text","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/generate(textFragment:in:)","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"one inline fragment","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Blocks are generated as lines, because block quotes and list items prefix them. This generator writes thematic breaks with underscores:","type":"text"}],"type":"paragraph"},{"code":["final class UnderscoreBreakGenerator: SourceGenerator, @unchecked Sendable {","  override func generate(block: Block, parent: Parent) -> [String] {","    if case .thematicBreak = block {","      return [\"___\"]","    }","    return super.generate(block: block, parent: parent)","  }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The rules which keep the source readable by the parser (where blank lines are needed, which characters are escaped, how emphasis next to emphasis is written) are not part of these methods. Not every change is safe: a heading written in another form, for example, can join the paragraph in front of it. Check a customized generator with ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator/roundTrips(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Write-the-source-of-custom-elements","level":3,"text":"Write the source of custom elements","type":"heading"},{"inlineContent":[{"text":"A custom block or text fragment writes its source with ","type":"text"},{"code":"generateSource(via:parent:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"generateSource(via:in:)","type":"codeVoice"},{"text":". See ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/Block":{"abstract":[{"text":"Enumeration of Markdown blocks. This enumeration defines the block structure,","type":"text"},{"text":" ","type":"text"},{"text":"i.e. the abstract syntax, of Markdown supported by MarkdownKit. The structure of","type":"text"},{"text":" ","type":"text"},{"text":"inline text is defined by the ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Text","isActive":true,"type":"reference"},{"text":" struct.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Block"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Block"}],"role":"symbol","title":"Block","type":"topic","url":"/documentation/markdownkit/block"},"doc://MarkdownKit/documentation/MarkdownKit/Block/normalized":{"abstract":[{"text":"The block in its normal form, for comparing syntax trees. Two trees that a parser produces","type":"text"},{"text":" ","type":"text"},{"text":"from texts that mean the same, such as ","type":"text"},{"code":"a (b) c","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"a \\(b\\) c","type":"codeVoice"},{"text":", have the same normal form.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"normalized"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit5BlockO","text":"Block"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block/normalized","kind":"symbol","role":"symbol","title":"normalized","type":"topic","url":"/documentation/markdownkit/block/normalized"},"doc://MarkdownKit/documentation/MarkdownKit/ConfiguringTheParser":{"abstract":[{"text":"Change which Markdown syntax a parser understands by choosing its block parsers and inline transformers.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ConfiguringTheParser","kind":"article","role":"article","title":"Configuring the Parser","type":"topic","url":"/documentation/markdownkit/configuringtheparser"},"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser":{"abstract":[{"code":"ExtendedMarkdownParser","type":"codeVoice"},{"text":" objects are used to parse Markdown text represented as a string","type":"text"},{"text":" ","type":"text"},{"text":"using all extensions to the CommonMark specification implemented by MarkdownKit.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExtendedMarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ExtendedMarkdownParser"}],"role":"symbol","title":"ExtendedMarkdownParser","type":"topic","url":"/documentation/markdownkit/extendedmarkdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser":{"abstract":[{"text":"Add your own inline markup to the Markdown syntax that MarkdownKit supports.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendingTheParser","kind":"article","role":"article","title":"Extending the Parser","type":"topic","url":"/documentation/markdownkit/extendingtheparser"},"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser":{"abstract":[{"code":"FullMarkdownParser","type":"codeVoice"},{"text":" objects are used to parse Markdown text represented as a string using","type":"text"},{"text":" ","type":"text"},{"text":"all features of MarkdownKit: the syntax of the CommonMark specification and all extensions","type":"text"},{"text":" ","type":"text"},{"text":"that MarkdownKit implements.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FullMarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"FullMarkdownParser"}],"role":"symbol","title":"FullMarkdownParser","type":"topic","url":"/documentation/markdownkit/fullmarkdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/GeneratingOutput":{"abstract":[{"text":"Convert a parsed Markdown document into HTML, attributed strings, plain text or text for ANSI terminals.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/GeneratingOutput","kind":"article","role":"article","title":"Generating Output","type":"topic","url":"/documentation/markdownkit/generatingoutput"},"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator":{"abstract":[{"code":"HtmlGenerator","type":"codeVoice"},{"text":" provides functionality for converting Markdown blocks into HTML. The","type":"text"},{"text":" ","type":"text"},{"text":"implementation is extensible allowing subclasses of ","type":"text"},{"code":"HtmlGenerator","type":"codeVoice"},{"text":" to override how","type":"text"},{"text":" ","type":"text"},{"text":"individual Markdown structures are converted into HTML.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"HtmlGenerator"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HtmlGenerator"}],"role":"symbol","title":"HtmlGenerator","type":"topic","url":"/documentation/markdownkit/htmlgenerator"},"doc://MarkdownKit/documentation/MarkdownKit/LaTeXMarkdownParser":{"abstract":[{"code":"LaTeXMarkdownParser","type":"codeVoice"},{"text":" is a ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathMarkdownParser","isActive":true,"type":"reference"},{"text":" which also recognizes the delimiters of","type":"text"},{"text":" ","type":"text"},{"text":"LaTeX for formulas:","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LaTeXMarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/LaTeXMarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"LaTeXMarkdownParser"}],"role":"symbol","title":"LaTeXMarkdownParser","type":"topic","url":"/documentation/markdownkit/latexmarkdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/ListDensity":{"abstract":[{"text":"Describes whether the blocks of a list item are separated by blank lines. The parser uses it","type":"text"},{"text":" ","type":"text"},{"text":"to find out whether the list which contains the item is tight or loose, and records it in","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"listItem","type":"codeVoice"},{"text":" block.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ListDensity"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListDensity","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ListDensity"}],"role":"symbol","title":"ListDensity","type":"topic","url":"/documentation/markdownkit/listdensity"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/Syntax-swift.struct":{"abstract":[{"text":"The features of Markdown that a ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SourceGenerator","isActive":true,"type":"reference"},{"text":" may use when it writes source:","type":"text"},{"text":" ","type":"text"},{"text":"the syntax of the parser that will read the source again. A tree can only be written","type":"text"},{"text":" ","type":"text"},{"text":"back faithfully if the syntax has the features that the tree uses. The syntax also","type":"text"},{"text":" ","type":"text"},{"text":"decides which characters of plain text have to be escaped: ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" only needs an escape","type":"text"},{"text":" ","type":"text"},{"text":"if the syntax has math.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syntax"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/Syntax-swift.struct","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Syntax"}],"role":"symbol","title":"MarkdownDialect.Syntax","type":"topic","url":"/documentation/markdownkit/markdowndialect/syntax-swift.struct"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/commonMark":{"abstract":[{"text":"CommonMark, parsed by ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"commonMark"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/commonMark","kind":"symbol","role":"symbol","title":"MarkdownDialect.commonMark","type":"topic","url":"/documentation/markdownkit/markdowndialect/commonmark"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/extendedCommonMark":{"abstract":[{"text":"CommonMark with tables and definition lists, parsed by ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"extendedCommonMark"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/extendedCommonMark","kind":"symbol","role":"symbol","title":"MarkdownDialect.extendedCommonMark","type":"topic","url":"/documentation/markdownkit/markdowndialect/extendedcommonmark"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/full":{"abstract":[{"text":"Everything that MarkdownKit supports but LaTeX math: additionally underline,","type":"text"},{"text":" ","type":"text"},{"text":"strikethrough and task lists, parsed by ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"full"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/full","kind":"symbol","role":"symbol","title":"MarkdownDialect.full","type":"topic","url":"/documentation/markdownkit/markdowndialect/full"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/fullLaTeX":{"abstract":[{"text":"Everything that MarkdownKit supports, including LaTeX formulas between dollar signs and","type":"text"},{"text":" ","type":"text"},{"text":"between the delimiters of LaTeX (","type":"text"},{"code":"\\(","type":"codeVoice"},{"text":"…","type":"text"},{"code":"\\)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"\\[","type":"codeVoice"},{"text":"…","type":"text"},{"code":"\\]","type":"codeVoice"},{"text":"), parsed by","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/LaTeXMarkdownParser","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"fullLaTeX"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/fullLaTeX","kind":"symbol","role":"symbol","title":"MarkdownDialect.fullLaTeX","type":"topic","url":"/documentation/markdownkit/markdowndialect/fulllatex"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/fullMath":{"abstract":[{"text":"Everything that MarkdownKit supports, including LaTeX formulas between dollar signs,","type":"text"},{"text":" ","type":"text"},{"text":"parsed by ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathMarkdownParser","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"fullMath"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/fullMath","kind":"symbol","role":"symbol","title":"MarkdownDialect.fullMath","type":"topic","url":"/documentation/markdownkit/markdowndialect/fullmath"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser":{"abstract":[{"code":"MarkdownParser","type":"codeVoice"},{"text":" objects are used to parse Markdown text represented as a string.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"MarkdownParser","type":"codeVoice"},{"text":" object itself defines the configuration of the parser. It is","type":"text"},{"text":" ","type":"text"},{"text":"stateless in the sense that it can be used for parsing many input strings. This is","type":"text"},{"text":" ","type":"text"},{"text":"done via the ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" function. ","type":"text"},{"code":"parse","type":"codeVoice"},{"text":" returns an abstract syntax tree representing","type":"text"},{"text":" ","type":"text"},{"text":"the Markdown text for the given input string.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MarkdownParser"}],"role":"symbol","title":"MarkdownParser","type":"topic","url":"/documentation/markdownkit/markdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/MathMarkdownParser":{"abstract":[{"code":"MathMarkdownParser","type":"codeVoice"},{"text":" is a ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","isActive":true,"type":"reference"},{"text":" which also recognizes LaTeX math:","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MathMarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathMarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MathMarkdownParser"}],"role":"symbol","title":"MathMarkdownParser","type":"topic","url":"/documentation/markdownkit/mathmarkdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/ProcessingMarkdown":{"abstract":[{"text":"Walk the abstract syntax tree of a parsed document to extract information or to transform it.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ProcessingMarkdown","kind":"article","role":"article","title":"Processing Markdown","type":"topic","url":"/documentation/markdownkit/proc