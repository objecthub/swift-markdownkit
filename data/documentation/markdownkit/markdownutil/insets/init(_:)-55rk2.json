/init(_:)-55rk2"},"doc://MarkdownKit/documentation/MarkdownKit/MarkdownUtil/pdf(_:title:author:pageSize:margins:renderingOptions:)":{"abstract":[{"text":"Returns the document as a PDF document: the content of a ","type":"text"},{"code":".pdf","type":"codeVoice"},{"text":" file. The text, lists,","type":"text"},{"text":" ","type":"text"},{"text":"tables, quotes and code blocks are laid out as they are in a text view, in the width of","type":"text"},{"text":" ","type":"text"},{"text":"the pages, and are broken into pages. Diagrams (see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/DrawingMermaidDiagrams","isActive":true,"type":"reference"},{"text":") and","type":"text"},{"text":" ","type":"text"},{"text":"formulas (see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathematicalFormulas","isActive":true,"type":"reference"},{"text":") are drawn as images. All diagrams are scaled","type":"text"},{"text":" ","type":"text"},{"text":"alike, so that a diagram of the width of a page for which Mermaid draws (800 points)","type":"text"},{"text":" ","type":"text"},{"text":"fills the text of a page; formulas are scaled down if they are wider than the text.","type":"text"},{"text":" ","type":"text"},{"text":"The numbers and bullets of lists sit on the baseline of the first line of their items.","type":"text"},{"text":" ","type":"text"},{"text":"Links are clickable (except those to a place in the same document, ","type":"text"},{"code":"#name","type":"codeVoice"},{"text":").","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"pdf"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit5BlockO","text":"Block"},{"kind":"text","text":", "},{"kind":"externalParam","text":"title"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","