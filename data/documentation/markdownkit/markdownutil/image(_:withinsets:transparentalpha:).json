{"abstract":[{"text":"Returns a copy of an image whose content has transparent space of exactly the given widths","type":"text"},{"text":" ","type":"text"},{"text":"between it and the edges (the insets): the transparent area around the content of the image","type":"text"},{"text":" ","type":"text"},{"text":"is removed, wherever it is wider than the inset asks for, and transparent space is added","type":"text"},{"text":" ","type":"text"},{"text":"where it is narrower, for each edge individually. The images that Mermaid and KaTeX draw are","type":"text"},{"text":" ","type":"text"},{"text":"not all alike in the space around their content; this gives them uniform insets, for","type":"text"},{"text":" ","type":"text"},{"text":"example for showing them in a document.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit","doc://MarkdownKit/documentation/MarkdownKit/MarkdownUtil"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownUtil/image(_:withInsets:transparentAlpha:)"},"kind":"symbol","metadata":{"extendedModule":"MarkdownKit","externalID":"s:11MarkdownKit0A4UtilV5image_10withInsets16transparentAlphaSo7NSImageCSgAH_AC0F0Vs5UInt8VtFZ","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"image"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit7HRImagea","text":"HRImage"},{"kind":"text","text":", "},{"kind":"externalParam","text":"withInsets"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit0A4UtilV6InsetsV","text":"Insets"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transparentAlpha"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5UInt8V","text":"UInt8"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit7HRImagea","text":"HRImage"},{"kind":"text","text":"?"}],"modules":[{"name":"MarkdownKit"}],"role":"symbol","roleHeading":"Type Method","symbolKind":"method","title":"image(_:withInsets:transparentAlpha:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"image"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"image"},{"kind":"text","text":": "},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HRImage","kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit7HRImagea","text":"HRImage"},{"kind":"text","text":", "},{"kind":"externalParam","text":"withInsets"},{"kind":"text","text":" "},{"kind":"internalParam","text":"insets"},{"kind":"text","text":": "},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownUtil/Insets","kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit0A4UtilV6InsetsV","text":"Insets"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transparentAlpha"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5UInt8V","text":"UInt8"},{"kind":"text","text":" = 4) -> "},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HRImage","kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit7HRImagea","text":"HRImage"},{"kind":"text","text":"?"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"An image with a transparent background.","type":"text"}],"type":"paragraph"}],"name":"image"},{"content":[{"inlineContent":[{"text":"The widths of the space around the content in points.","type":"text"}],"type":"paragraph"}],"name":"insets"},{"content":[{"inlineContent":[{"text":"The pixels whose alpha value (0 to 255) is at most this value count as","type":"text"},{"text":" ","typ