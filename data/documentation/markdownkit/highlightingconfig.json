{"abstract":[{"text":"Theme objects used for generating attributed strings.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig"},"kind":"symbol","metadata":{"externalID":"s:11MarkdownKit18HighlightingConfigV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HighlightingConfig"}],"modules":[{"name":"MarkdownKit"}],"navigatorTitle":[{"kind":"identifier","text":"HighlightingConfig"}],"role":"symbol","roleHeading":"Structure","symbolKind":"struct","title":"HighlightingConfig"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HighlightingConfig"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc://MarkdownKit/documentation/MarkdownKit/MigrationGuide","doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighting","doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently"]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"A theme is a CSS style sheet with rules for the classes that highlight.js assigns to the","type":"text"},{"text":" ","type":"text"},{"text":"parts of highlighted code, such as ","type":"text"},{"code":".hljs-keyword{color:#f00;font-weight:bold}","type":"codeVoice"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"selectors of the rules consist of classes: ","type":"text"},{"code":".a","type":"codeVoice"},{"text":", ","type":"text"},{"code":".a.b","type":"codeVoice"},{"text":", descendant selectors (","type":"text"},{"code":".a .b","type":"codeVoice"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"and child selectors (","type":"text"},{"code":".a > .b","type":"codeVoice"},{"text":"). The cascade follows CSS: a rule with a higher specificity","type":"text"},{"text":" ","type":"text"},{"text":"(more classes) wins over one with a lower specificity, otherwise the last rule wins.","type":"text"},{"text":" ","type":"text"},{"text":"The properties ","type":"text"},{"code":"color","type":"codeVoice"},{"text":", ","type":"text"},{"code":"background-color","type":"codeVoice"},{"text":", ","type":"text"},{"code":"font-weight","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"font-style","type":"codeVoice"},{"text":" are used.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"HighlightingConfig","type":"codeVoice"},{"text":" is a value type: copies are independent of each other, so changing a","type":"text"},{"text":" ","type":"text"},{"text":"property of a copy never affects a generator which uses the original. It conforms to","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":"; the conformance is ","type":"text"},{"code":"@unchecked","type":"codeVoice"},{"text":" only because ","type":"text"},{"code":"NSFont","type":"codeVoice"},{"text":" is not marked as","type":"text"},{"text":" ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" on macOS (fonts and colors are immutable).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The properties can be changed after creating a config. These properties influence how","type":"text"},{"text":" ","type":"text"},{"code":"apply","type":"codeVoice"},{"text":" styles text, and changes take effect immediately: the fonts ","type":"text"},{"code":"codeFont","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"boldCodeFont","type":"codeVoice"},{"text":", ","type":"text"},{"code":"italicCodeFont","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"boldItalicCodeFont","type":"codeVoice"},{"text":" (they are looked up when text","type":"text"},{"text":" ","type":"text"},{"text":"gets styled), ","type":"text"},{"code":"lineSpacing","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"paraSpacing","type":"codeVoice"},{"text":". The properties ","type":"text"},{"code":"themeBackgroundColor","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"fontSize","type":"codeVoice"},{"text":" are information for clients; ","type":"text"},{"code":"apply","type":"codeVoice"},{"text":" does not use them.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/AnsiHighlightingConfig":{"abstract":[{"text":"Configuration for converting syntax-highlighted HTML to ANSI terminal strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnsiHighlightingConfig"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AnsiHighlightingConfig","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AnsiHighlightingConfig"}],"role":"symbol","title":"AnsiHighlightingConfig","type":"topic","url":"/documentation/markdownkit/ansihighlightingconfig"},"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig":{"abstract":[{"text":"Theme objects used for generating attributed strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HighlightingConfig"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HighlightingConfig"}],"role":"symbol","title":"HighlightingConfig","type":"topic","url":"/documentation/markdownkit/highlightingconfig"},"doc://MarkdownKit/documentatio