pe":"text"},{"text":"font it is given.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"boldCodeFont"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit6HRFonta","text":"HRFont"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig/boldCodeFont","kind":"symbol","role":"symbol","title":"boldCodeFont","type":"topic","url":"/documentation/markdownkit/highlightingconfig/boldcodefont"},"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig/boldItalicCodeFont":{"abstract":[{"text":"The font of code which is bold and italic. ","type":"text"},{"code":"init(withTheme:usingFont:)","type":"codeVoice"},{"text":" derives it from","type":"text"},{"text":" ","type":"text"},{"text":"the font it is given.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"boldItalicCodeFont"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit6HRFonta","text":"HRFont"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig/boldItalicCodeFont","kind":"symbol","role":"symbol","title":"boldItalicCodeFont","type":"topic","url":"/documentation/markdownkit/highlightingconfig/bolditaliccodefont"},"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig/codeFont":{"abstract":[{"text":"The font of code which has no bold or italic style.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"codeFont"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11MarkdownKit6HRFonta","text":"HRFont"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig/codeFont","kind":"symbol","role":"symbol","title":"codeFont","type":"topic","url":"/documentation/markdownkit/highlightingconfig/codefont"},"doc://MarkdownKit/documentation/MarkdownKit/