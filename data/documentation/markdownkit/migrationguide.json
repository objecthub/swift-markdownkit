{"abstract":[{"text":"Find out what to change in your code when you update MarkdownKit.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/MigrationGuide"},"kind":"article","metadata":{"modules":[{"name":"MarkdownKit"}],"role":"article","roleHeading":"Article","title":"Migrating to Newer Versions"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"This article lists the changes that can break the source code of a client when it updates to a newer version, and how to adapt. For all changes, including new features and fixes, see the ","type":"text"},{"identifier":"https://github.com/objecthub/swift-markdownkit/blob/master/CHANGELOG.md","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Moving-to-22","level":3,"text":"Moving to 2.2","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"The parameter ","type":"text"},{"code":"full: Bool","type":"codeVoice"},{"text":" of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownText","isActive":true,"type":"reference"},{"text":" is gone: the new parameter ","type":"text"},{"code":"dialect:","type":"codeVoice"},{"text":" (a ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect","isActive":true,"type":"reference"},{"text":") replaces it. Replace ","type":"text"},{"code":"full: true","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"dialect: .full","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"full: false","type":"codeVoice"},{"text":" is the default (","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", which is ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownDialect/extendedCommonMark","isActive":true,"type":"reference"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Initializers have new parameters with default values: ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownText","isActive":true,"type":"reference"},{"text":" takes ","type":"text"},{"code":"prepare","type":"codeVoice"},{"text":", ","type":"text"},{"code":"math","type":"codeVoice"},{"text":", ","type":"text"},{"code":"alignListMarkers","type":"codeVoice"},{"text":", ","type":"text"},{"code":"style","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"darkStyle","type":"codeVoice"},{"text":", and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathAttributedStringGenerator","isActive":true,"type":"reference"},{"text":" take ","type":"text"},{"code":"alignListMarkers","type":"codeVoice"},{"text":", ","type":"text"},{"code":"headerFont","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"h1FontSize","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"h4FontSize","type":"codeVoice"},{"text":". Calls compile as before. Code that refers to an initializer by its full signature, such as ","type":"text"},{"code":"MarkdownText.init(_:waitingMessage:generator:)","type":"codeVoice"},{"text":" used as a function, has to use the new one. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":" also has the initializer ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/init(version:options:style:syntaxHighlighter:mermaid:mermaidRenderer:imageBaseUrl:alignListMarkers:renderingOptions:)","isActive":true,"type":"reference"},{"text":", which a subclass without initializers of its own inherits.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Moving-to-21","level":3,"text":"Moving to 2.1","type":"heading"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/htmlGenerator(options:)","isActive":true,"type":"reference"},{"text":" is a method instead of a property, so ","type":"text"},{"code":"generator.htmlGenerator","type":"codeVoice"},{"text":" becomes ","type":"text"},{"code":"generator.htmlGenerator()","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"options","type":"codeVoice"},{"text":" replace ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/renderingOptions-swift.property","isActive":true,"type":"reference"},{"text":" for the new generator and are ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" by default.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The method returns an ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/InternalHtmlGenerator","isActive":true,"type":"reference"},{"text":", not any ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":", because the generator also holds the Mermaid diagrams for the attributed string. A subclass that overrides the method has to return an ","type":"text"},{"code":"InternalHtmlGenerator","type":"codeVoice"},{"text":" (e.g. an instance of a subclass of it), and no longer a plain ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/Version-swift.enum/makeHtmlGenerator(for:renderingOptions:)","isActive":true,"type":"reference"},{"text":" returns an ","type":"text"},{"code":"InternalHtmlGenerator","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"makeHtmlGenerator(for:)","type":"codeVoice"},{"text":" is gone: pass the ","type":"text"},{"code":"renderingOptions","type":"codeVoice"},{"text":" of the generator.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The initializers of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/InternalHtmlGenerator","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/OS26HtmlGenerator","isActive":true,"type":"reference"},{"text":" require ","type":"text"},{"code":"renderingOptions","type":"codeVoice"},{"text":"; before, the parameter was optional and defaulted to the options of ","type":"text"},{"code":"outer","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The type ","type":"text"},{"code":"TerminalGenerator.TableDescriptor","type":"codeVoice"},{"text":" is gone. Its properties and initializer were not accessible outside of the framework. ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator","isActive":true,"type":"reference"},{"text":" and its ","type":"text"},{"code":"TableRenderer","type":"codeVoice"},{"text":" protocol use the top-level ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TableDescriptor","isActive":true,"type":"reference"},{"text":" now, which ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/StringGenerator","isActive":true,"type":"reference"},{"text":" uses as well and which has public properties. A custom table renderer for the terminal generator declares ","type":"text"},{"code":"renderTable(_:using:in:)","type":"codeVoice"},{"text":" with a ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TableDescriptor","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Moving-to-20","level":3,"text":"Moving to 2.0","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"New enum cases ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TextFragment/underline(_:)","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TextFragment/strikethrough(_:)","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/task(_:checked:)","isActive":true,"type":"reference"},{"text":": ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" statements over them have to handle the cases. The type of a task item wraps the original one, so use ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ListType/marker","isActive":true,"type":"reference"},{"text":" to get its bullet or number.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomBlock","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomTextFragment","isActive":true,"type":"reference"},{"text":" and the table renderer protocols refine ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". Subclasses of parsers and generators get the warning “must restate inherited ‘@unchecked Sendable’ conformance”: add ","type":"text"},{"code":"@unchecked Sendable","type":"codeVoice"},{"text":". See ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AnsiHighlightingConfig","isActive":true,"type":"reference"},{"text":" are structs: a config that you change has to be a ","type":"text"},{"code":"var","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator","isActive":true,"type":"reference"},{"text":" has the new initializer parameters ","type":"text"},{"code":"underlineProperties","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"strikethroughProperties","type":"codeVoice"},{"text":"; subclasses overriding the initializer have to adopt them.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/CustomTextFragment","isActive":true,"type":"reference"},{"text":" has the new requirements ","type":"text"},{"code":"generateText(via:)","type":"codeVoice"},{"text":" with default implementations, so existing conforming types still compile.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Coming-from-14-or-earlier","level":3,"text":"Coming from 1.4 or earlier","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Version 1.5 changed the output of the parsers and generators: all 652 examples of CommonMark 0.31.2 pass now, which fixed list looseness, tab stops, backslash escapes, link reference definitions, HTML blocks, tables and code spans. Hard line breaks are determined by the inline parser: ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/EscapeTransformer","isActive":true,"type":"reference"},{"text":" must be the last inline transformer, and trees from ","type":"text"},{"code":"parse(_:blockOnly: true)","type":"codeVoice"},{"text":" contain no hard line breaks. Generated HTML contains ","type":"text"},{"code":"&amp;","type":"codeVoice"},{"text":" for each ","type":"text"},{"code":"&","type":"codeVoice"},{"text":" in a URL.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter/proxy","isActive":true,"type":"reference"},{"text":" is a ","type":"text"},{"code":"static let","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"HtmlGenerator.init()","type":"codeVoice"},{"text":" is ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator/init(safeMode:)","isActive":true,"type":"reference"},{"text":". A subclass with ","type":"text"},{"code":"override init()","type":"codeVoice"},{"text":" has to declare ","type":"text"},{"code":"init()","type":"codeVoice"},{"text":" without ","type":"text"},{"code":"override","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Version 1.3 changed the signature of case ","type":"text"},{"code":"listItem","type":"codeVoice"},{"text":" of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block","isActive":true,"type":"reference"},{"text":", which enabled the fix of loose list detection.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/AnsiHighlightingConfig":{"abstract":[{"text":"Configuration for converting syntax-highlighted HTML to ANSI terminal strings.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnsiHighlightingConfig"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AnsiHighlightingConfig","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"A