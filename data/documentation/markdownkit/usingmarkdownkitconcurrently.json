{"abstract":[{"text":"Parse and generate on background threads and tasks, and know what to restate in subclasses.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/UsingMarkdownKitConcurrently"},"kind":"article","metadata":{"modules":[{"name":"MarkdownKit"}],"role":"article","roleHeading":"Article","title":"Using MarkdownKit Concurrently"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"MarkdownKit is compiled in Swift 6 language mode and supports strict concurrency checking. Abstract syntax trees (","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TextFragment","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Text","isActive":true,"type":"reference"},{"text":", …), options and configuration types (such as ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/RenderingOptions-swift.struct","isActive":true,"type":"reference"},{"text":") are ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" value types. Parsers (","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MarkdownParser","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/ExtendedMarkdownParser","isActive":true,"type":"reference"},{"text":"), generators (","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HtmlGenerator","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/StringGenerator","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/TerminalGenerator","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":"), table renderers and the ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/SyntaxHighlighter","isActive":true,"type":"reference"},{"text":" are immutable objects and ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" as well (the highlighting configurations ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/HighlightingConfig","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AnsiHighlightingConfig","isActive":true,"type":"reference"},{"text":" are value types), so a single instance can be used from several threads or tasks at the same time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Parsing in a background task and using the resulting ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Block","isActive":true,"type":"reference"},{"text":" on the main actor works:","type":"text"}],"type":"paragraph"},{"code":["let doc = await Task.detached { ExtendedMarkdownParser.standard.parse(text) }.value","let attributedStr = try await AttributedStringGenerator.standard.generateAsync(doc: doc)"],"syntax":"swift","type":"codeListing"},{"anchor":"Generate-attributed-strings-off-the-main-thread","level":3,"text":"Generate attributed strings off the main thread","type":"heading"},{"inlineContent":[{"text":"The synchronous methods of ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator","isActive":true,"type":"reference"},{"text":" (","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/generate(doc:)","isActive":true,"type":"reference"},{"text":" etc.) use the system’s HTML importer, which Apple documents as usable on the main thread only. From other threads, use ","type":"text"},{"code":"generateAsync","type":"codeVoice"},{"text":". It exists in two forms:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"generateAsync(doc:options:)","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" method that returns the attributed string or throws an ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/AttributedStringGenerator/RenderingError","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"generateAsync(doc:options:completionHandler:)","type":"codeVoice"},{"text":" is for code that does not use Swift concurrency. The handler is called exactly once, asynchronously, on the main thread.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Both also load Mermaid diagrams (see ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/DrawingMermaidDiagrams","isActive":true,"type":"reference"},{"text":") before they generate the attributed string.","type":"text"}],"type":"paragraph"},{"anchor":"Subclass-parsers-and-generators","level":3,"text":"Subclass parsers and generators","type":"heading"},{"inlineContent":[{"text":"The classes are ","type":"text"},{"code":"open","type":"codeVoice"},{"text":", so their ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" conformance is ","type":"text"},{"code":"@unchecked","type":"codeVoice"},{"text":". Subclasses restate it as ","type":"text"},{"code":"@unchecked Sendable","type":"codeVoice"},{"text":" (the compiler warns otherwise) and have to make sure that state they add is immutable or synchronized.","type":"text"}],"type":"paragraph"},{"code":["final class MyGenerator: HtmlGenerator, @unchecked