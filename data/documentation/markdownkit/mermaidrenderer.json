{"abstract":[{"text":"Turns ","type":"text"},{"identifier":"https://mermaid.js.org","isActive":true,"type":"reference"},{"text":" diagram descriptions into images.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/MermaidRenderer"},"kind":"symbol","metadata":{"externalID":"s:11MarkdownKit15MermaidRendererC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MermaidRenderer"}],"modules":[{"name":"MarkdownKit"}],"navigatorTitle":[{"kind":"identifier","text":"MermaidRenderer"}],"role":"symbol","roleHeading":"Class","symbolKind":"class","title":"MermaidRenderer"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MermaidRenderer"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc://MarkdownKit/documentation/MarkdownKit/DrawingMermaidDiagrams"]},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Mermaid is a JavaScript library which needs a web browser’s DOM and layout engine to","type":"text"},{"text":" ","type":"text"},{"text":"measure text. In contrast to ","type":"text"},{"code":"SyntaxHighlighter","type":"codeVoice"},{"text":" (which runs Highlight.js in","type":"text"},{"text":" ","type":"text"},{"text":"JavaScriptCore), ","type":"text"},{"code":"MermaidRenderer","type":"codeVoice"},{"text":" therefore loads the bundled ","type":"text"},{"code":"mermaid.min.js","type":"codeVoice"},{"text":" into a","type":"text"},{"text":" ","type":"text"},{"text":"headless ","type":"text"},{"code":"WKWebView","type":"codeVoice"},{"text":". This is only available on macOS and iOS. The web view is created when","type":"text"},{"text":" ","type":"text"},{"text":"the first diagram is rendered, is used for all following diagrams, and is released when it","type":"text"},{"text":" ","type":"text"},{"text":"has been idle for a while. Its content cannot access the network, and it has no connection to","type":"text"},{"text":" ","type":"text"},{"text":"the rest of the application.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Rendering is asynchronous. Images are cached, so rendering a diagram a second time (with the","type":"text"},{"text":" ","type":"text"},{"text":"same configuration) is immediate; ","type":"text"},{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" only looks at that cache when","type":"text"},{"text":" ","type":"text"},{"text":"it generates attributed strings synchronously (see ","type":"text"},{"code":"AttributedStringGenerator.prepareDiagrams","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"MermaidRenderer","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". It can be used from any thread or task; the requests are","type":"text"},{"text":" ","type":"text"},{"text":"processed one after the other.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc://MarkdownKit/documentation/MarkdownKit/DrawingMermaidDiagrams","isActive":true,"type":"reference"},{"text":" for an introduction.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Example:","type":"text"}],"type":"paragraph"},{"code":["if let renderer = MermaidRenderer.shared {","  let image = try await renderer.render(\"graph LR\\n  A --> B\")","  try image.pngData.write(to: url)","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/DrawingMermaidDiagrams":{"abstract":[{"text":"Show fenced code blocks with the language ","type":"text"},{"code":"mermaid","type":"codeVoice"},{"text":" as diagrams in attributed strings.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/DrawingMermaidDiagrams","kind":"article","role":"article","title":"Drawing Mermaid Diagrams","type":"topic","url":"/documentation/markdownkit/drawingmermaiddiagrams"},"doc://MarkdownKit/documentation/MarkdownKit/MermaidConfig":{"abstract":[{"text":"Configures how ","type":"text"},{"code":"MermaidRenderer","type":"codeVoice"},{"text":" draws Mermaid diagrams, and how","type":"text"},{"text":" ","type":"text"},{"code":"AttributedStringGenerator","type":"codeVoice"},{"text":" places them in an attributed string. Passing a","type":"text"},{"text":" ","type":"text"},{"code":"MermaidConfig","type":"codeVoice"},{"text":" to the ","type":"text"},{"code":"mermaid:","type":"codeVoice"},{"text":" parameter of ","type":"text"},{"code":"AttributedStringGenerator.init","type":"codeVoice"},{"text":" enables","type":"text"},{"text":" ","type":"text"},{"text":"the rendering of fenced code blocks with the language ","type":"text"},{"code":"mermaid","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MermaidConfig"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MermaidConfig","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MermaidConfig"}],"role":"symbol","title":"MermaidConfig","type":"topic","url":"/documentation/markdownkit/mermaidconfig"},"doc://MarkdownKit/documentation/MarkdownKit/MermaidDiagramContext":{"abstract":[{"text":"Keeps track of the diagrams which an HTML generator has put into the HTML. The system’s HTML","type":"text"},{"text":" ","type":"text"},{"text":"importer cannot place images with a given size (it ignores the size attributes, and the","type":"text"},{"text":" ","type":"text"},{"text":"resolution of an image is interpreted differently on macOS and iOS), so the HTML contains a","type":"text"},{"text":" ","type":"text"},{"text":"piece of text instead of an image. Once the HTML has been turned into an attributed string,","type":"text"},{"text":" ","type":"text"},{"code":"replacePlaceholders(in:)","type":"codeVoice"},{"text":" replaces each of these pieces of text with an ","type":"text"},{"code":"NSTextAttachment","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MermaidDiagramContext"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MermaidDiagramContext","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MermaidDiagramContext"}],"role":"symbol","title":"MermaidDiagramContext","type":"topic","url":"/documentation/markdownkit/mermaiddiagramcontext"},"doc://MarkdownKit/documentation/MarkdownKit/MermaidError":{"abstract":[{"text":"Errors thrown by ","type":"text"},{"code":"MermaidRenderer","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MermaidError"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MermaidError","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MermaidError"}],"role":"symbol","title":"MermaidError","type":"topic","url":"/documentation/markdownkit/mermaiderror"},"doc://MarkdownKit/documentation/MarkdownKit/MermaidImage":{"abstract":[{"text":"A rendered Mermaid diagram: a PNG image with transparent background.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MermaidImage"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/Merma