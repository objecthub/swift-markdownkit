down text represented as a string using","type":"text"},{"text":" ","type":"text"},{"text":"all features of MarkdownKit: the syntax of the CommonMark specification and all extensions","type":"text"},{"text":" ","type":"text"},{"text":"that MarkdownKit implements.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FullMarkdownParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/FullMarkdownParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"FullMarkdownParser"}],"role":"symbol","title":"FullMarkdownParser","type":"topic","url":"/documentation/markdownkit/fullmarkdownparser"},"doc://MarkdownKit/documentation/MarkdownKit/IndentedCodeBlockParser":{"abstract":[{"text":"A code block parser which parses indented code blocks returning ","type":"text"},{"code":"indentedCode","type":"codeVoice"},{"text":" blocks.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"IndentedCodeBlockParser"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/IndentedCodeBlockParser","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"IndentedCodeBlockParser"}],"role":"symbol","title":"IndentedCodeBlockParser","type":"topic","url":"/documentation/markdownkit/indentedcodeblockparser"},"doc://MarkdownKit/documentation/MarkdownKit/InlineTransformer":{"abstract":[{"text":"Class ","type":"text"},{"code":"InlineTransformer","type":"codeVoice"},{"text":" defines a framework for plugins which transform a given","type":"text"},{"text":" ","type":"text"},{"text":"unstructured or semi-structured text with Markdown markup into a structured","type":"text"},{"text":" ","type":"text"},{"text":"representation which uses ","type":"text"},{"code":"TextFragment","type":"codeVoice"},{"text":" objects. MarkdownKit implements a separate","type":"text"},{"text":" ","type":"text"},{"text":"inline transformer plugin for every class o