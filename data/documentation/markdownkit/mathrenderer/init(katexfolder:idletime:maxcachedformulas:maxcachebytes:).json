{"abstract":[{"text":"Creates a renderer which uses KaTeX from the folder ","type":"text"},{"code":"katexFolder","type":"codeVoice"},{"text":", which contains the files","type":"text"},{"text":" ","type":"text"},{"code":"katex.min.js","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"katex.min.css","type":"codeVoice"},{"text":", and the folder ","type":"text"},{"code":"fonts","type":"codeVoice"},{"text":" of KaTeX.","type":"text"}],"hierarchy":{"paths":[["doc://MarkdownKit/documentation/MarkdownKit","doc://MarkdownKit/documentation/MarkdownKit/MathRenderer"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://MarkdownKit/documentation/MarkdownKit/MathRenderer/init(katexFolder:idleTime:maxCachedFormulas:maxCacheBytes:)"},"kind":"symbol","metadata":{"externalID":"s:11MarkdownKit12MathRendererC11katexFolder8idleTime17maxCachedFormulas0I10CacheBytesACSg10Foundation3URLV_SdS2itcfc","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"katexFolder"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"idleTime"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxCachedFormulas"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxCacheBytes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":")"}],"modules":[{"name":"MarkdownKit"}],"role":"symbol","roleHeading":"Initializer","symbolKind":"init","title":"init(katexFolder:idleTime:maxCachedFormulas:maxCacheBytes:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"convenience"},{"kind":"text","text":" "},{"kind":"keyword","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"katexFolder"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"idleTime"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":" = MathRenderer.defaultIdleTime, "},{"kind":"externalParam","text":"maxCachedFormulas"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = MathRenderer.defaultMaxCachedFormulas, "},{"kind":"externalParam","text":"maxCacheBytes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" = MathRenderer.defaultMaxCacheBytes)"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The folder with the files of KaTeX.","type":"text"}],"type":"paragraph"}],"name":"katexFolder"},{"content":[{"inlineContent":[{"text":"The time in seconds after which the web view is released if no formula is being","type":"text"},{"text":" ","type":"text"},{"text":"rendered. That frees the memory of the web view and of its web content","type":"text"},{"text":" ","type":"text"},{"text":"process; the next formula needs a new web view, which takes a moment. 0 (or","type":"text"},{"text":" ","type":"text"},{"text":"less) releases the web view as soon as no request is waiting for it,","type":"text"},{"text":" ","type":"text"},{"code":".infinity","type":"codeVoice"},{"text":" never releases it. The default is ","type":"text"},{"code":"defaultIdleTime","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"idleTime"},{"content":[{"inlineContent":[{"text":"The maximal number of cached results (images, and formulas which KaTeX","type":"text"},{"text":" ","type":"text"},{"text":"rejected). When there are more, the ones which were used least recently are","type":"text"},{"text":" ","type":"text"},{"text":"dropped. At least 1; the default is ","type":"text"},{"code":"defaultMaxCachedFormulas","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"MathAttributedStringGenerator.generate(doc:)","type":"codeVoice"},{"text":" only shows the formulas that","type":"text"},{"text":" ","type":"text"},{"text":"are in the cache, so it should be at least the number of formulas of the","type":"text"},{"text":" ","type":"text"},{"text":"largest document that is displayed with it; ","type":"text"},{"code":"generateAsync","type":"codeVoice"},{"text":" does not depend","type":"text"},{"text":" ","type":"text"},{"text":"on the size of the cache.","type":"text"}],"type":"paragraph"}],"name":"maxCachedFormulas"},{"content":[{"inlineContent":[{"text":"The maximal total size of the cached PNG images in bytes (an image is","type":"text"},{"text":" ","type":"text"},{"text":"about 10 KB). When it is exceeded, the images which were used least recently","type":"text"},{"text":" ","type":"text"},{"text":"are dropped. At least 1; the default is ","type":"text"},{"code":"defaultMaxCacheBytes","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"maxCacheBytes"}]},{"content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"A renderer, or ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the files of KaTeX cannot be read.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://MarkdownKit/documentation/MarkdownKit":{"abstract":[{"text":"Parse, process and display text in Markdown format.","type":"text"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit","kind":"symbol","role":"collection","title":"MarkdownKit","type":"topic","url":"/documentation/markdownkit"},"doc://MarkdownKit/documentation/MarkdownKit/MathRenderer":{"abstract":[{"code":"MathRenderer","type":"codeVoice"},{"text":" typesets LaTeX formulas with KaTeX and draws them into images. KaTeX runs in a","type":"text"},{"text":" ","type":"text"},{"text":"headless web view, which is created when the first formula is rendered, renders many formulas","type":"text"},{"text":" ","type":"text"},{"text":"at a time, and is released when it has not been used for a while. The images (black on a","type":"text"},{"text":" ","type":"text"},{"text":"transparent background; the colour is applied when a formula is shown) are cached.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MathRenderer"}],"identifier":"doc://MarkdownKit/documentation/MarkdownKit/MathRenderer","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MathRenderer"}],"role":"symbol","title":"MathRenderer","type":"topic","url":"/documentation/markdownkit/mathrenderer"},"doc://MarkdownKit/documentation/MarkdownKit/MathRenderer/init(katexFolder:idleTime:maxCachedFormulas:maxCacheBytes:)":{"abstract":[{"text":"Creates a renderer which uses KaTeX from the folder ","type":"text"},{"code":"katexFolder","type":"codeVoice"},{"text":", which contains the files","type":"text"},{"text":" ","type":"text"},{"code":"katex.min.js","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"katex.min.css","type":"codeVoice"},{"text":", and the folder ","type":"text"},{"code":"fonts","type":"codeVoice"},{"text":" of KaTeX.","type":"text"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"katexFolder"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"idleTime"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":", "},{"kind":"exter